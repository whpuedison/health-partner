.diet-page {
  min-height: 100vh;
  background: #F7FAFC;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

/* Define Tomato Theme Variables */
page {
  --tomato-red: #E9503F; /* A strong tomato red */
  --gradient-tomato: linear-gradient(135deg, #FF6B6B 0%, #E9503F 100%);
}

/* 1. 周历 */
.week-calendar {
  background: white;
  padding: 24rpx 20rpx;
  margin: 0 0 24rpx; /* Remove negative margin, independent card */
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.calendar-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.calendar-nav {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--tomato-red);
  background: rgba(233, 80, 63, 0.1);
  border-radius: 50%;
  flex-shrink: 0;
  transition: all 0.2s;
}

.calendar-nav:active {
  background: rgba(233, 80, 63, 0.2);
  transform: scale(0.95);
}

.calendar-days {
  flex: 1;
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}

.day-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.day-item.today {
  color: var(--tomato-red);
}

.day-item.selected {
  background: var(--tomato-red);
  box-shadow: 0 4rpx 12rpx rgba(233, 80, 63, 0.3);
}

.day-item.selected .day-week,
.day-item.selected .day-number {
  color: white;
}

.day-week {
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 8rpx;
}

.day-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D3748;
}

/* ================== 通用卡片样式 ================== */
.diet-card {
  background: white;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06); /* Deeper shadow */
}

.diet-card.records-card {
    padding: 0;
    overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F7FAFC;
}

.records-card .card-header {
    margin: 24rpx 30rpx 0;
}

.card-title-icon {
  font-size: 32rpx;
}

.card-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3748;
}

/* ================== 2. 今日概览 ================== */
.overview-row {
  display: flex;
  align-items: flex-end; /* Align bottom */
  justify-content: space-between;
  padding: 12rpx 0;
}

.overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.overview-item.center {
  flex: 1.2;
}

.item-label {
  font-size: 22rpx;
  color: #A0AEC0;
  margin-bottom: 8rpx;
}

.value-row {
    display: flex;
    align-items: baseline;
    gap: 4rpx;
}

.item-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2D3748;
  font-family: 'DIN Alternate', sans-serif;
  line-height: 1;
}

.unit {
    font-size: 20rpx;
    color: #CBD5E0;
    font-weight: normal;
}

.center .item-value {
  font-size: 56rpx;
  color: var(--tomato-red);
}

/* ================== 3. 营养分析 ================== */
.nutrient-item {
  margin-bottom: 24rpx;
}

.nutrient-item:last-child {
  margin-bottom: 0;
}

.nutrient-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.nutrient-name {
  font-size: 26rpx;
  color: #4A5568;
  font-weight: 500;
}

.nutrient-value {
  font-size: 26rpx;
  color: #2D3748;
  font-weight: 600;
}

.nutrient-bar {
  height: 12rpx;
  background: #F5F5F5;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.bar-fill.protein { background: linear-gradient(90deg, #FADB14 0%, #FFD700 100%); }
.bar-fill.fat { background: linear-gradient(90deg, #FF6B6B 0%, #E9503F 100%); }
.bar-fill.carbs { background: linear-gradient(90deg, #E6A23C 0%, #F39C12 100%); }

/* ================== 4. AI 记录 (Pill Buttons) ================== */
.ai-button-group {
    display: flex;
    gap: 24rpx;
}

.ai-btn {
    flex: 1;
    height: 80rpx;
    background: var(--pale-orange);
    border-radius: 36rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    color: var(--tomato-red);
    font-weight: 600;
    box-shadow: 0 2rpx 8rpx rgba(233, 80, 63, 0.1);
}

.ai-btn:active {
    transform: scale(0.96);
}

.ai-btn.camera {
    background: var(--gradient-orange);
    color: var(--white);
    box-shadow: 0 4rpx 12rpx rgba(239, 143, 65, 0.25);
}

.ai-btn.text {
    background: var(--pale-orange);
}

.ai-icon {
    font-size: 32rpx;
}

.ai-text {
    font-size: 28rpx;
    font-weight: 600;
}

/* ================== 5. 饮食明细列表 ================== */
.meal-section {
  border-bottom: 1rpx solid #F7FAFC;
}

.meal-section:last-child {
  border-bottom: none;
}

.meal-header {
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: white;
}

.meal-header:active {
  background: #FAFAFA;
}

.meal-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.meal-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3748;
  flex-shrink: 0;
}

.meal-summary {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: flex-end;
}

.meal-count {
  font-size: 24rpx;
  color: #A0AEC0;
}

.meal-calories {
  font-size: 24rpx;
  color: var(--tomato-red); /* Muted color for header summary */
  font-weight: 600;
}

.expand-icon {
  font-size: 20rpx;
  color: #CBD5E0;
  transition: transform 0.3s;
  margin-left: 8rpx;
}

.expand-icon.expanded {
  transform: rotate(180deg);
}

.records-list {
  background: #FAFAFA; /* Index page style background */
  overflow: hidden;
  transition: all 0.3s ease;
  padding: 0 16rpx; /* Padding for inner list */
}

.records-list.collapsed {
  max-height: 0;
  padding-top: 0;
  padding-bottom: 0;
}

.records-list.expanded {
  max-height: 2000rpx;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #E2E8F0;
  gap: 12rpx;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.food-name {
  font-size: 28rpx;
  color: #2D3748;
  font-weight: 500;
}

.record-time {
  font-size: 22rpx;
  color: #A0AEC0;
}

.food-calories {
  font-size: 28rpx;
  color: var(--vibrant-orange);
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
}


.delete-icon {
  font-size: 28rpx;
  color: var(--vibrant-orange);
  padding: 8rpx;
}

.empty-records {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: #A0AEC0;
}

/* ================== 弹窗样式 (番茄红主题) ================== */
/* 拍照提示 */
.photo-tip-popup, .text-input-popup, .recognition-popup {
    padding: 40rpx 32rpx;
    width: 600rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}
.recognition-popup { width: 640rpx; max-height: 85vh; }

.tip-title, .popup-title, .selector-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #2D3748;
    text-align: center;
    margin-bottom: 32rpx;
    display: block;
}

.tip-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
    margin-bottom: 40rpx;
}

.tip-item {
    display: flex;
    align-items: center;
    gap: 16rpx;
    background: #FFFBF7; /* 浅橙背景 */
    padding: 24rpx;
    border-radius: 16rpx;
}

.tip-icon { font-size: 32rpx; flex-shrink: 0; }
.tip-text { font-size: 28rpx; color: #4A5568; line-height: 1.4; }

/* 按钮统一 */
.start-photo-btn, .submit-text-btn, .save-result-btn {
    background: var(--gradient-tomato) !important;
    border: none !important;
    height: 88rpx !important;
    border-radius: 44rpx !important;
    font-size: 30rpx !important;
}

/* 文本输入 */
.diet-textarea {
    width: 100%;
    min-height: 240rpx;
    padding: 24rpx;
    background-color: #F7FAFC;
    border-radius: 16rpx; 
    font-size: 28rpx;
    line-height: 1.6;
    box-sizing: border-box;
    margin-bottom: 16rpx;
}

.input-tip {
    background: #FFF9E6;
    border-radius: 12rpx;
    padding: 16rpx;
    margin-bottom: 24rpx;
    display: flex;
    align-items: flex-start;
    gap: 12rpx;
}

.tip-content {
    flex: 1;
    font-size: 24rpx;
    color: #8B7355;
    line-height: 1.6;
}

.text-count { text-align: right; font-size: 24rpx; color: #A0AEC0; margin-bottom: 32rpx; }

/* 识别结果摘要 */
.recognition-summary {
    background: rgba(233, 80, 63, 0.05); /* Tomato tint */
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
    flex-shrink: 0;
}
.summary-item { display: flex; justify-content: space-between; padding: 8rpx 0; }
.summary-label { font-size: 26rpx; color: #4A5568; font-weight: 500; }
.summary-value { font-size: 28rpx; color: var(--tomato-red); font-weight: 600; }
.summary-row { display: flex; justify-content: space-around; padding-top: 16rpx; border-top: 1rpx solid rgba(233, 80, 63, 0.1); margin-top: 12rpx; }
.summary-small { font-size: 24rpx; color: #718096; }

/* 食物列表 */
.food-list { flex: 1; overflow-y: auto; margin-bottom: 24rpx; min-height: 0; max-height: 500rpx; }
.food-item {
    background: white;
    border: 1rpx solid #EDF2F7;
    border-radius: 16rpx;
    padding: 20rpx;
    margin-bottom: 16rpx;
    display: flex;
    align-items: center;
    gap: 16rpx;
}
.food-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.food-name { font-size: 28rpx; color: #2D3748; font-weight: 500; }
.food-detail { font-size: 24rpx; color: #718096; }
.food-actions { display: flex; gap: 20rpx; }
.edit-icon, .delete-food-icon { font-size: 32rpx; color: var(--tomato-red); padding: 8rpx; }
.delete-food-icon { transform: scale(1.3); }
/* 食物编辑 */
.food-edit { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
.edit-input { width: 100%; height: 64rpx; background: #F7FAFC; border-radius: 8rpx; padding: 0 16rpx; font-size: 26rpx; box-sizing: border-box; }
.edit-actions { display: flex; gap: 16rpx; }
.edit-btn { flex: 1; text-align: center; padding: 12rpx; border-radius: 8rpx; font-size: 24rpx; }
.edit-btn.cancel { background: #EDF2F7; color: #718096; }
.edit-btn.save { background: var(--tomato-red); color: white; }

/* 添加食物按钮 */
.add-food-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8rpx;
    padding: 24rpx;
    border: 2rpx dashed var(--tomato-red);
    border-radius: 16rpx;
    background: rgba(233, 80, 63, 0.05); /* Tomato tint */
    margin-top: 8rpx;
}
.add-icon { color: var(--tomato-red); font-size: 32rpx; font-weight: bold; }
.add-text { color: var(--tomato-red); font-size: 28rpx; font-weight: 500; }

/* 餐次选择器 */
.meal-selector { padding: 40rpx 32rpx; }
/* .selector-title handled above in group selector */
.meal-options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24rpx; }
.meal-option {
    background: #F7FAFC;
    border-radius: 16rpx;
    padding: 32rpx 24rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12rpx;
    transition: all 0.2s;
}
.meal-option:active { background: #EDF2F7; transform: scale(0.98); }
.meal-option .meal-icon { font-size: 48rpx; }
.meal-option .meal-name { font-size: 28rpx; color: #2D3748; font-weight: 500; }

/* 锁定遮罩 */
.locked-overlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(2px);
    z-index: 10; display: flex; justify-content: center; align-items: center;
    border-radius: 20rpx;
}
.lock-content { display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #718096; font-size: 24rpx; }
.lock-icon { font-size: 48rpx; opacity: 0.6; }
.unlock-btn {
    margin-top: 12rpx;
    background: var(--gradient-tomato);
    color: white; font-size: 22rpx; padding: 8rpx 24rpx; border-radius: 30rpx; border: none; line-height: 1.5;
}
