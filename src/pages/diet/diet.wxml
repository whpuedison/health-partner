<view class="diet-page">
  <!-- 周历 -->
  <view class="week-calendar">
    <view class="calendar-container">
      <text class="calendar-nav" bindtap="changeWeek" data-type="prev">◀</text>
      
      <view class="calendar-days">
        <view 
          class="day-item {{item.isToday ? 'today' : ''}} {{selectedDate === item.date ? 'selected' : ''}}"
          wx:for="{{weekDays}}"
          wx:key="date"
          data-date="{{item.date}}"
          bindtap="selectDate"
        >
          <text class="day-week">{{item.weekDay}}</text>
          <text class="day-number">{{item.day}}</text>
        </view>
      </view>
      
      <text class="calendar-nav" bindtap="changeWeek" data-type="next">▶</text>
    </view>
  </view>

  <!-- 1. 今日概览卡片 -->
  <view class="diet-card">
    <view class="card-header">
      <text class="card-title-icon">📊</text>
      <text class="card-title-text">今日概览</text>
    </view>
    <view class="overview-row">
      <view class="overview-item">
        <text class="item-label">饮食摄入</text>
        <view class="value-row">
            <text class="item-value">{{todayIntake}}</text>
            <text class="unit">kcal</text>
        </view>
      </view>
      <view class="overview-item center">
        <text class="item-label">还可以吃</text>
        <view class="value-row">
            <text class="item-value">{{todayRemaining}}</text>
            <text class="unit">kcal</text>
        </view>
      </view>
      <view class="overview-item">
        <text class="item-label">运动消耗</text>
        <view class="value-row">
            <text class="item-value">{{todayBurned}}</text>
            <text class="unit">kcal</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 2. 营养分析卡片 -->
  <view class="diet-card">
    <view class="card-header">
      <text class="card-title-icon">🥗</text>
      <text class="card-title-text">营养分析</text>
    </view>
    <view class="nutrient-item">
      <view class="nutrient-header">
        <text class="nutrient-name">蛋白质</text>
        <text class="nutrient-value">{{protein.current}}g / {{protein.target}}g</text>
      </view>
      <view class="nutrient-bar">
        <view class="bar-fill protein" style="width: {{(protein.current / protein.target) * 100}}%"></view>
      </view>
    </view>
    
    <view class="nutrient-item">
      <view class="nutrient-header">
        <text class="nutrient-name">脂肪</text>
        <text class="nutrient-value">{{fat.current}}g / {{fat.target}}g</text>
      </view>
      <view class="nutrient-bar">
        <view class="bar-fill fat" style="width: {{(fat.current / fat.target) * 100}}%"></view>
      </view>
    </view>
    
    <view class="nutrient-item">
      <view class="nutrient-header">
        <text class="nutrient-name">碳水</text>
        <text class="nutrient-value">{{carbs.current}}g / {{carbs.target}}g</text>
      </view>
      <view class="nutrient-bar">
        <view class="bar-fill carbs" style="width: {{(carbs.current / carbs.target) * 100}}%"></view>
      </view>
    </view>
  </view>

  <!-- 3. AI 记录卡片 -->
  <view class="diet-card" style="position: relative;">
    <view class="card-header">
      <text class="card-title-icon">🤖</text>
      <text class="card-title-text">AI 记录</text>
    </view>
    
    <view class="ai-button-group">
        <!-- 一句话记录 -->
        <view class="ai-btn text" bindtap="showTextInputDialog">
            <text class="ai-icon">✏️</text>
            <text class="ai-text">AI文字识别</text>
        </view>
        <!-- 拍照识别 -->
        <view class="ai-btn camera" bindtap="showPhotoTipDialog">
            <text class="ai-icon">📷</text>
            <text class="ai-text">AI拍照识别</text>
        </view>
    </view>

    <!-- Locked Overlay -->
    <view class="locked-overlay" wx:if="{{isLocked}}">
        <view class="lock-content">
            <view class="lock-icon">🔒</view>
            <text>分享后解锁AI识别热量</text>
            <button class="unlock-btn" open-type="share" bindtap="onShareClick">去解锁</button>
        </view>
    </view>
  </view>

  <!-- 4. 饮食明细卡片 -->
  <view class="diet-card records-card">
    <view class="card-header">
      <text class="card-title-icon">📝</text>
      <text class="card-title-text">饮食明细</text>
    </view>
    
    <!-- 早餐 -->
    <view class="meal-section" wx:if="{{mealGroups.breakfast.length > 0}}">
      <!-- Header -->
      <view class="meal-header" bindtap="toggleMeal" data-meal="breakfast">
        <text class="meal-icon">🌅</text>
        <text class="meal-title">早餐</text>
        <view class="meal-summary">
          <text class="meal-count">{{mealStats.breakfast.count}}项</text>
          <text class="meal-calories">{{mealStats.breakfast.totalCalories}} kcal</text>
        </view>
        <text class="expand-icon {{expandedMeals.breakfast ? 'expanded' : ''}}">▼</text>
      </view>
      <!-- List -->
      <view class="records-list {{expandedMeals.breakfast ? 'expanded' : 'collapsed'}}">
        <view class="record-item" wx:for="{{mealGroups.breakfast}}" wx:key="id">
          <view class="record-info">
            <text class="food-name">{{item.foodName}}</text>
            <text class="record-time">{{item.time}}</text>
          </view>
          <text class="food-calories">{{item.calories}} kcal</text>
          <text class="delete-icon" data-id="{{item.id}}" bindtap="deleteRecord">✕</text>
        </view>
      </view>
    </view>

    <!-- 午餐 -->
    <view class="meal-section" wx:if="{{mealGroups.lunch.length > 0}}">
      <view class="meal-header" bindtap="toggleMeal" data-meal="lunch">
        <text class="meal-icon">🌞</text>
        <text class="meal-title">午餐</text>
        <view class="meal-summary">
          <text class="meal-count">{{mealStats.lunch.count}}项</text>
          <text class="meal-calories">{{mealStats.lunch.totalCalories}} kcal</text>
        </view>
        <text class="expand-icon {{expandedMeals.lunch ? 'expanded' : ''}}">▼</text>
      </view>
      <view class="records-list {{expandedMeals.lunch ? 'expanded' : 'collapsed'}}">
        <view class="record-item" wx:for="{{mealGroups.lunch}}" wx:key="id">
          <view class="record-info">
            <text class="food-name">{{item.foodName}}</text>
            <text class="record-time">{{item.time}}</text>
          </view>
          <text class="food-calories">{{item.calories}} kcal</text>
          <text class="delete-icon" data-id="{{item.id}}" bindtap="deleteRecord">✕</text>
        </view>
      </view>
    </view>

    <!-- 晚餐 -->
    <view class="meal-section" wx:if="{{mealGroups.dinner.length > 0}}">
      <view class="meal-header" bindtap="toggleMeal" data-meal="dinner">
        <text class="meal-icon">🌙</text>
        <text class="meal-title">晚餐</text>
        <view class="meal-summary">
          <text class="meal-count">{{mealStats.dinner.count}}项</text>
          <text class="meal-calories">{{mealStats.dinner.totalCalories}} kcal</text>
        </view>
        <text class="expand-icon {{expandedMeals.dinner ? 'expanded' : ''}}">▼</text>
      </view>
      <view class="records-list {{expandedMeals.dinner ? 'expanded' : 'collapsed'}}">
        <view class="record-item" wx:for="{{mealGroups.dinner}}" wx:key="id">
          <view class="record-info">
            <text class="food-name">{{item.foodName}}</text>
            <text class="record-time">{{item.time}}</text>
          </view>
          <text class="food-calories">{{item.calories}} kcal</text>
          <text class="delete-icon" data-id="{{item.id}}" bindtap="deleteRecord">✕</text>
        </view>
      </view>
    </view>

    <!-- 加餐 -->
    <view class="meal-section" wx:if="{{mealGroups.snack.length > 0}}">
      <view class="meal-header" bindtap="toggleMeal" data-meal="snack">
        <text class="meal-icon">🍎</text>
        <text class="meal-title">加餐</text>
        <view class="meal-summary">
          <text class="meal-count">{{mealStats.snack.count}}项</text>
          <text class="meal-calories">{{mealStats.snack.totalCalories}} kcal</text>
        </view>
        <text class="expand-icon {{expandedMeals.snack ? 'expanded' : ''}}">▼</text>
      </view>
      <view class="records-list {{expandedMeals.snack ? 'expanded' : 'collapsed'}}">
        <view class="record-item" wx:for="{{mealGroups.snack}}" wx:key="id">
          <view class="record-info">
            <text class="food-name">{{item.foodName}}</text>
            <text class="record-time">{{item.time}}</text>
          </view>
          <text class="food-calories">{{item.calories}} kcal</text>
          <text class="delete-icon" data-id="{{item.id}}" bindtap="deleteRecord">✕</text>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-records" wx:if="{{mealGroups.breakfast.length === 0 && mealGroups.lunch.length === 0 && mealGroups.dinner.length === 0 && mealGroups.snack.length === 0}}">
      <text class="empty-icon">🍽️</text>
      <text class="empty-text">今天还没有记录哦</text>
    </view>
  </view>

  <!-- 拍照提示弹窗 -->
  <van-popup
    show="{{showPhotoTip}}"
    round
    closeable
    bind:close="closePhotoTip"
  >
    <view class="photo-tip-popup">
      <text class="tip-title">📸 拍照小贴士</text>
      <view class="tip-list">
        <view class="tip-item">
          <text class="tip-icon">💡</text>
          <text class="tip-text">将食物放在光线充足的地方</text>
        </view>
        <view class="tip-item">
          <text class="tip-icon">📐</text>
          <text class="tip-text">向下俯拍图片效果好</text>
        </view>
        <view class="tip-item">
          <text class="tip-icon">🚫</text>
          <text class="tip-text">避免遮挡和阴影</text>
        </view>
        <view class="tip-item">
          <text class="tip-icon">🍱</text>
          <text class="tip-text">可以拍摄多种食物</text>
        </view>
      </view>
      <van-button type="primary" block custom-class="start-photo-btn" bindtap="startPhoto">
        开始拍照
      </van-button>
    </view>
  </van-popup>

  <!-- 识别结果弹窗 -->
  <van-popup
    show="{{showRecognitionResult}}"
    round
    closeable
    bind:close="closeRecognitionResult"
  >
    <view class="recognition-popup">
      <text class="popup-title">识别结果</text>
      
      <view class="recognition-summary">
        <view class="summary-item">
          <text class="summary-label">总卡路里</text>
          <text class="summary-value">{{recognitionData.totalNutrition.totalCalories}} kcal</text>
        </view>
        <view class="summary-row">
          <text class="summary-small">蛋白质 {{recognitionData.totalNutrition.totalProtein}}g</text>
          <text class="summary-small">脂肪 {{recognitionData.totalNutrition.totalFat}}g</text>
          <text class="summary-small">碳水 {{recognitionData.totalNutrition.totalCarbs}}g</text>
        </view>
      </view>
      
      <view class="food-list">
        <view class="food-item" wx:for="{{recognitionData.foods}}" wx:key="index" wx:for-index="idx">
          <view class="food-info" wx:if="{{editingFoodIndex !== idx}}">
            <text class="food-name">{{item.name}}</text>
            <text class="food-detail">{{item.weight}}g · {{item.calorie}} kcal</text>
          </view>
          
          <view class="food-edit" wx:else>
            <input class="edit-input" placeholder="食物名称" value="{{editFoodName}}" bindinput="onEditNameInput" />
            <input class="edit-input" type="digit" placeholder="重量(g)" value="{{editFoodWeight}}" bindinput="onEditWeightInput" />
            <view class="edit-actions">
              <text class="edit-btn cancel" bindtap="cancelEdit">取消</text>
              <text class="edit-btn save" bindtap="saveEdit">保存</text>
            </view>
          </view>
          
          <view class="food-actions" wx:if="{{editingFoodIndex !== idx}}">
            <text class="edit-icon" data-index="{{idx}}" bindtap="editFood">✎</text>
            <text class="delete-food-icon" data-index="{{idx}}" bindtap="deleteFood">x</text>
          </view>
        </view>

        <!-- 新增食物按钮 -->
        <view class="add-food-btn" bindtap="addNewFood">
          <text class="add-icon">+</text>
          <text class="add-text">添加食物</text>
        </view>
      </view>
      
      <van-button type="primary" block custom-class="save-result-btn" bindtap="showMealSelector">
        保存记录
      </van-button>
    </view>
  </van-popup>

  <!-- 文本输入弹窗 -->
  <van-popup
    show="{{showTextInput}}"
    round
    closeable
    bind:close="closeTextInput"
  >
    <view class="text-input-popup">
      <text class="popup-title">一句话记饮食</text>
      <view class="input-tip">
        <text class="tip-icon">💡</text>
        <text class="tip-content">例如：早餐吃了一碗牛肉面、一个煎蛋、一杯豆浆</text>
      </view>
      <textarea 
        class="diet-textarea" 
        placeholder="描述你吃了什么，越详细越准确哦~"
        value="{{dietText}}"
        bindinput="onDietTextInput"
        maxlength="200"
        show-confirm-bar="{{false}}"
      />
      <view class="text-count">{{dietText.length}}/200</view>
      <van-button type="primary" block custom-class="submit-text-btn" bindtap="submitTextRecognition">
        开始识别
      </van-button>
    </view>
  </van-popup>

  <!-- 餐次选择弹窗 -->
  <van-popup
    show="{{showMealTypeSelector}}"
    position="bottom"
    round
  >
    <view class="meal-selector">
      <text class="selector-title">选择餐次</text>
      <view class="meal-options">
        <view 
          class="meal-option"
          wx:for="{{mealTypes}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="selectMealType"
        >
          <text class="meal-icon">{{item.icon}}</text>
          <text class="meal-name">{{item.value}}</text>
        </view>
      </view>
    </view>
  </van-popup>

  <ai-loading show="{{aiLoading}}" text="{{loadingText}}" />

  <van-toast id="van-toast" />
</view>
