<!--pages/diet/diet.wxml-->
<view class="diet-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">饮食计划</text>
    <text class="page-subtitle">记录每一餐，掌握营养摄入</text>
  </view>

  <!-- 卡路里总览 -->
  <view class="calorie-card">
    <view class="calorie-main">
      <text class="calorie-value">{{totalCalories}}</text>
      <text class="calorie-unit">/ {{targetCalories}} 卡</text>
    </view>
    <view class="calorie-progress">
      <view class="calorie-fill" style="width: {{totalCalories / targetCalories * 100}}%"></view>
    </view>
    <view class="calorie-status">
      <text>{{totalCalories >= targetCalories ? '已达标 ✓' : '剩余 ' + (targetCalories - totalCalories) + ' 卡'}}</text>
    </view>
  </view>

  <!-- 标签切换 -->
  <!-- <view class="tabs">
    <view 
      class="tab-item {{activeTab === index ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="index"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      {{item}}
    </view>
  </view> -->

  <!-- 今日记录 -->
  <view class="tab-content" wx:if="{{activeTab === 0}}">
    <!-- 添加选项 -->
    <view class="add-options">
      <view class="add-btn primary" bindtap="openPhotoRecognition">
        <text class="add-icon">📷</text>
        <text class="add-name">拍照识图</text>
        <text class="add-desc">上传食物图片自动识别</text>
      </view>
      <view class="add-btn secondary" data-type="manual" bindtap="openAddDialog">
        <text class="add-icon">✏️</text>
        <text class="add-name">手动添加</text>
        <text class="add-desc">从数据库选择食物</text>
      </view>
    </view>

    <!-- 记录列表 -->
    <view class="records-list" wx:if="{{todayRecords.length > 0}}">
      <view class="record-item" wx:for="{{todayRecords}}" wx:key="id">
        <text class="record-icon">{{item.foodIcon}}</text>
        <view class="record-info">
          <view class="record-name-row">
            <text class="record-name">{{item.food}}</text>
          </view>
          <text class="record-time">{{item.time}}</text>
        </view>
        <view class="record-stats">
          <text class="record-stat">{{item.calories}}卡</text>
        </view>
        <text class="delete-btn" data-id="{{item.id}}" bindtap="deleteRecord">✕</text>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <text class="empty-icon">🍽️</text>
      <text class="empty-text">还没有记录，点击上方添加今日饮食</text>
    </view>
  </view>

  <!-- 推荐食谱（暂时隐藏） -->
  <view class="tab-content" wx:if="false">
    <view class="recipe-grid">
      <view class="recipe-card" wx:for="{{recommendations}}" wx:key="id">
        <image class="recipe-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="recipe-info">
          <text class="recipe-name">{{item.name}}</text>
          <view class="recipe-tags">
            <text class="recipe-tag">{{item.category}}</text>
            <text class="recipe-tag">{{item.calories}}卡</text>
          </view>
          <text class="recipe-desc">{{item.description}}</text>
        </view>
        <view class="recipe-actions">
          <button class="recipe-btn detail" data-recipe="{{item}}" bindtap="viewRecipeDetail">查看详情</button>
          <button class="recipe-btn primary" data-recipe="{{item}}" bindtap="useRecipe">使用</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 营养分析 -->
  <view class="tab-content" wx:if="{{activeTab === 1}}">
    <view class="nutrition-card">
      <text class="nutrition-title">今日营养摄入</text>
      
      <view class="nutrition-item">
        <view class="nutrition-header">
          <text class="nutrition-name">🥩 蛋白质</text>
          <text class="nutrition-value">{{nutrition.protein}}g</text>
        </view>
        <view class="nutrition-bar">
          <view class="nutrition-fill protein" style="width: {{nutrition.protein / 100 * 100}}%"></view>
        </view>
      </view>

      <view class="nutrition-item">
        <view class="nutrition-header">
          <text class="nutrition-name">🍚 碳水化合物</text>
          <text class="nutrition-value">{{nutrition.carbs}}g</text>
        </view>
        <view class="nutrition-bar">
          <view class="nutrition-fill carbs" style="width: {{nutrition.carbs / 250 * 100}}%"></view>
        </view>
      </view>

      <view class="nutrition-item">
        <view class="nutrition-header">
          <text class="nutrition-name">🥑 脂肪</text>
          <text class="nutrition-value">{{nutrition.fat}}g</text>
        </view>
        <view class="nutrition-bar">
          <view class="nutrition-fill fat" style="width: {{nutrition.fat / 70 * 100}}%"></view>
        </view>
      </view>

      <view class="nutrition-item">
        <view class="nutrition-header">
          <text class="nutrition-name">🌾 膳食纤维</text>
          <text class="nutrition-value">{{nutrition.fiber}}g</text>
        </view>
        <view class="nutrition-bar">
          <view class="nutrition-fill fiber" style="width: {{nutrition.fiber / 30 * 100}}%"></view>
        </view>
      </view>
    </view>

    <view class="nutrition-tips">
      <text class="tips-title">💡 营养建议</text>
      <text class="tips-text">• 建议每日蛋白质摄入约 100g</text>
      <text class="tips-text">• 碳水化合物控制在 250g 左右</text>
      <text class="tips-text">• 脂肪摄入不超过 70g</text>
      <text class="tips-text">• 膳食纤维至少 25-30g</text>
    </view>
  </view>

  <!-- 添加对话框 - 级联选择 -->
  <view class="dialog-mask" wx:if="{{showAddDialog}}" bindtap="closeAddDialog">
    <view class="dialog-content" catchtap="stopPropagation">
      <view class="dialog-header">
        <text class="dialog-title">添加食物</text>
        <text class="dialog-close" bindtap="closeAddDialog">✕</text>
      </view>
      
      <view class="dialog-body">
        <!-- 第一步：选择分类 -->
        <view class="cascade-step" wx:if="{{dialogStep === 'category'}}">
          <text class="step-title">选择食物分类</text>
          <view class="category-list">
            <view 
              class="category-item" 
              wx:for="{{categories}}" 
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="selectCategory"
            >
              <text class="category-icon">{{item.icon || '🍽️'}}</text>
              <text class="category-name">{{item.name}}</text>
            </view>
          </view>
        </view>

        <!-- 第二步：选择食物 -->
        <view class="cascade-step" wx:if="{{dialogStep === 'food'}}">
          <view class="step-header">
            <text class="step-back" bindtap="goBack">← 返回</text>
            <text class="step-title">{{selectedCategory.name}}</text>
          </view>
          
          <!-- 搜索框 -->
          <view class="search-box">
            <input 
              class="search-input" 
              placeholder="搜索食物..."
              value="{{searchKeyword}}"
              bindinput="onSearchInput"
            />
          </view>
          
          <!-- 食物列表 -->
          <view class="food-list">
            <view 
              class="food-item" 
              wx:for="{{foods}}" 
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="selectFood"
            >
              <text class="food-icon">{{item.icon || '🍽️'}}</text>
              <view class="food-info">
                <text class="food-name">{{item.name}}</text>
                <text class="food-calories">{{item.caloriesPer100g}}卡/100g</text>
              </view>
              <text class="food-arrow">></text>
            </view>
          </view>
        </view>

        <!-- 第三步：选择单位 -->
        <view class="cascade-step" wx:if="{{dialogStep === 'unit'}}">
          <view class="step-header">
            <text class="step-back" bindtap="goBack">← 返回</text>
            <text class="step-title">{{selectedFood.name}}</text>
          </view>
          
          <!-- 单位列表 -->
          <view class="unit-list" wx:if="{{units.length > 0}}">
            <view 
              class="unit-item {{selectedUnit && selectedUnit.id === item.id ? 'active' : ''}}" 
              wx:for="{{units}}" 
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="selectUnit"
            >
              <text class="unit-name">{{item.unitName}}</text>
              <text class="unit-weight">({{item.weightGrams}}g)</text>
            </view>
          </view>
          
          <!-- 自定义重量 -->
          <view class="custom-weight-box">
            <text class="form-label">或输入自定义重量（克）</text>
            <input 
              class="form-input" 
              type="digit"
              placeholder="例如：150"
              value="{{customWeight}}"
              bindinput="onCustomWeightInput"
            />
          </view>
          
          <!-- 计算后的营养信息 -->
          <view class="nutrition-preview" wx:if="{{calculatedNutrition}}">
            <text class="preview-title">营养信息</text>
            <view class="preview-item">
              <text class="preview-label">卡路里：</text>
              <text class="preview-value">{{calculatedNutrition.calories}}卡</text>
            </view>
            <view class="preview-item">
              <text class="preview-label">蛋白质：</text>
              <text class="preview-value">{{calculatedNutrition.protein}}g</text>
            </view>
            <view class="preview-item">
              <text class="preview-label">碳水：</text>
              <text class="preview-value">{{calculatedNutrition.carbs}}g</text>
            </view>
            <view class="preview-item">
              <text class="preview-label">脂肪：</text>
              <text class="preview-value">{{calculatedNutrition.fat}}g</text>
            </view>
          </view>
        </view>
      </view>
      
      <view class="dialog-footer">
        <button class="dialog-btn cancel" bindtap="closeAddDialog">取消</button>
        <button 
          class="dialog-btn confirm" 
          bindtap="confirmAdd"
          wx:if="{{dialogStep === 'unit' && calculatedNutrition}}"
        >确定</button>
      </view>
    </view>
  </view>

  <!-- 食物识别对话框 -->
  <view class="dialog-mask" wx:if="{{showRecognitionDialog}}" bindtap="closeRecognitionDialog">
    <view class="dialog-content recognition-dialog" catchtap="stopPropagation">
      <view class="dialog-header">
        <text class="dialog-title">选择识别结果</text>
        <text class="dialog-close" bindtap="closeRecognitionDialog">✕</text>
      </view>

      <view class="dialog-body">
        <!-- 识别结果列表 -->
        <view class="recognition-list">
          <view
            class="recognition-item {{selectedRecognition && selectedRecognition.name === item.name ? 'active' : ''}}"
            wx:for="{{recognizedFoods}}"
            wx:key="name"
            data-food="{{item}}"
            bindtap="selectRecognizedFood"
          >
            <text class="recognition-icon">🍽️</text>
            <view class="recognition-info">
              <text class="recognition-name">{{item.name}}</text>
              <view class="recognition-meta">
                <text class="recognition-calorie">{{item.calorie}}卡/100g</text>
              </view>
            </view>
            <text class="recognition-probability">相似度: {{item.probability}}</text>
            <text class="recognition-arrow">></text>
          </view>
        </view>

        <!-- 分量设置 -->
        <view class="weight-section" wx:if="{{selectedRecognition}}">
          <text class="weight-label">请输入{{selectedRecognition.name}}的分量（克）</text>
          <input
            class="form-input weight-input"
            type="digit"
            placeholder="例如：150"
            value="{{recognitionWeight}}"
            bindinput="onRecognitionWeightInput"
          />
        </view>
      </view>

      <view class="dialog-footer">
        <button class="dialog-btn cancel" bindtap="closeRecognitionDialog">取消</button>
        <button
          class="dialog-btn confirm"
          bindtap="confirmRecognitionAdd"
          wx:if="{{selectedRecognition && recognitionWeight}}"
        >确定</button>
      </view>
    </view>
  </view>
</view>
