/* pages/questionnaire/questionnaire.wxss */
.questionnaire-page {
  background: #F0F9F5;
  height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)) 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

/* 主容器 */
.main-container {
  background: white;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* 提示文字 */
.progress-hint {
  text-align: center;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.hint-text {
  font-size: 28rpx;
  color: #666666;
  letter-spacing: 1rpx;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #E8F5E8;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 48rpx;
  flex-shrink: 0;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #B8E6C8 0%, #A0D8B0 100%);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

/* 步骤内容 */
.step-content {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 问题区域 */
.question-section {
  text-align: center;
  margin-bottom: 40rpx;
  flex-shrink: 0;
}

.question-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.question-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  padding: 0 20rpx;
}

/* 选项容器 */
.options-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  flex-wrap: wrap;
  padding: 0 20rpx;
  flex: 1;
  align-items: center;
}

/* 选项项 */
.option-item {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.option-avatar {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s ease;
  position: relative;
  background: #F5F5F5;
}

.male-avatar {
  background: #F5F5F5;
}

.female-avatar {
  background: #F5F5F5;
}

.avatar-icon {
  font-size: 70rpx;
  font-weight: 300;
  color: #333333;
  line-height: 1;
}

.option-item.selected .option-avatar {
  transform: scale(1.1);
  box-shadow: 0 8rpx 24rpx rgba(184, 230, 200, 0.3);
  background: linear-gradient(135deg, #B8E6C8 0%, #A0D8B0 100%);
}

.option-item.selected .avatar-icon {
  color: #000000;
}

.option-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  transition: color 0.3s ease;
  letter-spacing: 1rpx;
}

.option-item.selected .option-text {
  color: #000000;
  font-weight: 600;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #29ac57;
  box-shadow: 0 4rpx 12rpx rgba(184, 230, 200, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(184, 230, 200, 0.2);
}

.btn-secondary {
  background: white;
  color: #666666;
  border: 2rpx solid #E0E0E0;
}

.btn-secondary:active {
  background: #F7FAFC;
}

/* 刻度尺容器 */
.ruler-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 500rpx;
  margin: 40rpx 0;
  width: 100%;
}

.weight-container {
  margin-bottom: 100rpx;
  width: 100%;
}

/* 身高/体重显示 */
.height-display {
  margin-top: 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
}

.height-value {
  font-size: 64rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1;
}

.height-unit {
  font-size: 32rpx;
  color: #666666;
  line-height: 1;
}

/* BMI 卡片 */
.bmi-card {
  background: white;
  border: 2rpx solid #B8E6C8;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(184, 230, 200, 0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.card-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #3cc51f;
}

/* BMI 状态条 */
.bmi-bar {
  position: relative;
  height: 16rpx;
  background: linear-gradient(to right,
    #87CEEB 0%,    /* 偏瘦: 天蓝色 - 青色表示轻微偏离 */
    #87CEEB 15%,
    #66BB6A 15%,   /* 正常: 深绿色 - 绿色表示健康 */
    #66BB6A 40%,
    #FFA726 40%,   /* 偏重: 橙色 - 橙色表示注意 */
    #FFA726 65%,
    #EF5350 65%,   /* 肥胖: 红色 - 红色表示警报 */
    #EF5350 100%
  );
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  overflow: visible;
}

.bmi-section {
  float: left;
}

.underweight { width: 15%; }
.normal { width: 25%; }
.overweight { width: 25%; }
.obese { width: 35%; }

.bmi-indicator {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 24rpx;
  background: #006400;
  border-radius: 4rpx;
  z-index: 10;
}

/* BMI 标签 */
.bmi-labels {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}

.bmi-label {
  font-size: 26rpx;
  color: #666666;
  text-align: center;
  flex: 1;
}

/* BMI 状态 */
.bmi-status {
  text-align: center;
  margin-bottom: 30rpx;
}

.status-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

/* 健康建议 */
.bmi-advice {
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 32rpx;
}

.advice-icon {
  font-size: 32rpx;
}

.advice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-left: 8rpx;
  vertical-align: middle;
}

.advice-list {
  margin-top: 20rpx;
}

.advice-item {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.advice-item:last-child {
  margin-bottom: 0;
}

/* 日期选择器 */
.date-selector-container {
  display: flex;
  justify-content: center;
  margin: 40rpx 0;
}

.date-display {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 16rpx;
  padding: 32rpx 40rpx;
  min-width: 300rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.date-display:active {
  background: #e9ecef;
  border-color: #B8E6C8;
}

.date-label {
  display: block;
  font-size: 28rpx;
  color: #6c757d;
  margin-bottom: 16rpx;
}

.selected-date {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #495057;
}

.date-arrow {
  display: block;
  font-size: 32rpx;
  margin-top: 16rpx;
}

/* 年龄评估 box */
.age-assessment {
  background: white;
  border: 2rpx solid #B8E6C8;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(184, 230, 200, 0.1);
}

.assessment-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.assessment-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #3cc51f;
}

.assessment-content {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.assessment-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: justify;
}

/* 目标体重对比 box */
.target-comparison {
  background: white;
  border: 2rpx solid #B8E6C8;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(184, 230, 200, 0.1);
}

.comparison-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.comparison-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #3cc51f;
  padding: 16rpx 24rpx;
  background: #F0F9F5;
  border-radius: 16rpx;
  display: inline-block;
}

.comparison-content {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.comparison-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: justify;
}

/* 周数选择器容器 */
.week-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 300rpx;
  margin: 40rpx 0;
  width: 100%;
}

/* 时间线规划 box */
.timeline-planning {
  background: white;
  border: 2rpx solid #B8E6C8;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(184, 230, 200, 0.1);
}

.planning-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.planning-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #3cc51f;
  padding: 16rpx 24rpx;
  background: #F0F9F5;
  border-radius: 16rpx;
  display: inline-block;
  line-height: 1.4;
}

.planning-content {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 24rpx;
}

.planning-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  text-align: justify;
}

/* 目标日期选择器容器 */
.target-date-container {
  display: flex;
  justify-content: center;
  margin: 40rpx 0;
}

/* 目标日期规划 box */
.goal-planning {
  background: white;
  border: 2rpx solid #B8E6C8;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(184, 230, 200, 0.1);
}

.goal-planning .planning-value,
.goal-planning .planning-text {
  color: #3cc51f;
}

.goal-planning .planning-value {
  background: #F0F9F5;
}
