<!--pages/questionnaire/questionnaire.wxml-->
<!-- Loading界面 -->
<view class="loading-container" wx:if="{{isLoading}}">
  <view class="loading-spinner-section">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载</text>
  </view>
</view>

<!-- 问卷界面 -->
<view class="questionnaire-page" wx:else>
  <!-- 主容器：包含进度和步骤内容 -->
  <view class="main-container">
    <!-- 提示文字 -->
    <view class="progress-hint">
      <text class="hint-text">完成评测，为你生成专属方案</text>
    </view>
    
    <!-- 进度条 -->
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{(currentStep / totalSteps) * 100}}%"></view>
    </view>

    <!-- 步骤1：性别选择 -->
    <view class="step-content" wx:if="{{currentStep === 1}}">
      <view class="question-section">
        <text class="question-title">你的性别是?</text>
        <text class="question-desc">生理性别和激素会影响我们身体代谢食物的方式</text>
      </view>

      <view class="options-container">
        <view 
          class="option-item {{selectedGender === 'male' ? 'selected' : ''}}"
          data-gender="male"
          bindtap="selectGender"
        >
         <image class="option-avatar" src="https://whpuedison.online/images/male_avatar.png"></image>
          <text class="option-text">男性</text>
        </view>
        
        <view 
          class="option-item {{selectedGender === 'female' ? 'selected' : ''}}"
          data-gender="female"
          bindtap="selectGender"
        >
          <image class="option-avatar" src="https://whpuedison.online/images/female_avatar.png"></image>
          <text class="option-text">女性</text>
        </view>
      </view>
    </view>

    <!-- 步骤2：身高选择 -->
    <view class="step-content" wx:if="{{currentStep === 2}}">
      <view class="question-section">
        <text class="question-title">你的身高是?</text>
        <text class="question-desc">准确的身高数据有助于我们计算你的基础代谢率</text>
      </view>

      <view class="ruler-container">
        <height-picker
          min="120"
          max="220"
          value="{{selectedHeight}}"
          bindchange="onHeightChange"
        />
      </view>

      <view class="action-buttons">
        <button class="btn btn-secondary" bindtap="prevStep">上一步</button>
        <button class="btn btn-primary" bindtap="nextStep">下一步</button>
      </view>
    </view>

    <!-- 步骤3：体重选择 -->
    <view class="step-content" wx:if="{{currentStep === 3}}">
      <view class="question-section">
        <text class="question-title">你的体重是?</text>
        <text class="question-desc">精准体重数据将用于计算你的BMI</text>
      </view>

      <view class="weight-container">
        <weight-picker
          min="30"
          max="200"
          value="{{selectedWeight}}"
          bindchange="onWeightChange"
        />
      </view>

      <!-- BMI 卡片 -->
      <view class="bmi-card">
        <view class="card-header">
          <text class="card-title">体重指数 (BMI)</text>
          <text class="card-value">{{bmi}}</text>
        </view>

        <view class="bmi-bar">
          <view class="bmi-section underweight"></view>
          <view class="bmi-section normal"></view>
          <view class="bmi-section overweight"></view>
          <view class="bmi-section obese"></view>
          <view class="bmi-indicator" style="left: {{bmiIndicatorPosition}}%"></view>
        </view>

        <view class="bmi-labels">
          <text class="bmi-label">偏瘦</text>
          <text class="bmi-label">正常</text>
          <text class="bmi-label">偏重</text>
          <text class="bmi-label">肥胖</text>
        </view>

        <view class="bmi-status">
          <text class="status-text">当前状态：{{bmiStatus}}</text>
        </view>

        <view class="bmi-advice">
          <text class="advice-icon">💡</text>
          <text class="advice-title">健康建议</text>
          <view class="advice-list">
            <text class="advice-item" wx:for="{{bmiSuggestions}}" wx:key="*item">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="action-buttons">
        <button class="btn btn-secondary" bindtap="prevStep">上一步</button>
        <button class="btn btn-primary" bindtap="nextStep">下一步</button>
      </view>
    </view>

    <!-- 步骤4：出生日期选择 -->
    <view class="step-content" wx:if="{{currentStep === 4}}">
      <view class="question-section">
        <text class="question-title">你的出生日期是?</text>
        <text class="question-desc">年龄与基础代谢水平、身体活动水平息息相关</text>
      </view>

      <view class="date-selector-container">
        <view class="date-display" bindtap="showDatePicker">
          <text class="date-label">选择出生日期</text>
          <text class="selected-date">{{formattedDate}}</text>
          <text class="date-arrow">📅</text>
        </view>
      </view>

      <!-- 年龄评估 box -->
      <view class="age-assessment" wx:if="{{age > 0}}">
        <view class="assessment-header">
          <text class="assessment-value">{{age}} 岁</text>
        </view>
        <view class="assessment-content">
          <text class="assessment-text">{{ageDescription}}</text>
        </view>
      </view>

      <view class="action-buttons">
        <button class="btn btn-secondary" bindtap="prevStep">上一步</button>
        <button class="btn btn-primary" bindtap="nextStep">下一步</button>
      </view>
    </view>

    <!-- 步骤5：目标体重选择 -->
    <view class="step-content" wx:if="{{currentStep === 5}}">
      <view class="question-section">
        <text class="question-title">你的目标体重是?</text>
        <text class="question-desc">请设定您的减重目标，我们专注于以健康速率
        （如每周0.5-1公斤）安全减肥，并为您生成个性化方案
        </text>
      </view>

      <view class="weight-container target-weight-container">
        <weight-picker
          min="30"
          max="{{selectedWeight}}"
          markWidth="{{20}}"
          value="{{targetWeight}}"
          bindchange="onTargetWeightChange"
        />
      </view>

      <!-- 目标体重对比 box -->
      <view class="target-comparison" wx:if="{{weightChangeType !== 'maintain'}}">
        <view class="comparison-header">
          <text class="comparison-value">目标{{weightChangeType === 'gain' ? '增重' : '减重'}}: {{weightChangePercent}}%</text>
        </view>
        <view class="comparison-content">
          <text class="comparison-text">{{targetEncouragement}}</text>
        </view>
      </view>

      <!-- 完成问卷按钮 -->
      <view class="action-buttons">
        <button class="btn btn-secondary" bindtap="prevStep">上一步</button>
        <button class="btn btn-primary" bindtap="nextStep">下一步</button>
        <!-- <button class="btn btn-primary" bindtap="submitQuestionnaire">完成问卷</button> -->
      </view>
    </view>

    <!-- 步骤6：目标达成日期选择 -->
    <view class="step-content" wx:if="{{currentStep === 6}}">
      <view class="question-section">
        <text class="question-title">你希望什么时候达到目标体重?</text>
        <text class="question-desc">选择合理的目标完成日期，帮你制定具体的行动计划</text>
      </view>

      <view class="target-date-container">
        <view class="date-display" bindtap="showTargetDatePicker">
          <text class="date-label">选择目标完成日期</text>
          <text class="selected-date">{{targetDate || '请稍候...'}}</text>
          <text class="date-arrow">📅</text>
        </view>
      </view>

      <!-- 目标日期规划 box -->
      <view class="goal-planning" wx:if="{{targetDate}}">
        <view class="planning-header">
          <text class="planning-value">{{targetDate}} ({{daysLeft}} 天后)</text>
        </view>
        <view class="planning-content">
          <text class="planning-text">需要每周 {{weeklyChangeForDate}}kg {{weightChangeTypeForDate === 'lose' ? '减重' : weightChangeTypeForDate === 'gain' ? '增重' : '维持'}}，{{goalDateEncouragement}}</text>
        </view>
      </view>

      <!-- 完成问卷按钮 -->
      <view class="action-buttons">
        <button class="btn btn-secondary" bindtap="prevStep">上一步</button>
        <button class="btn btn-primary" bindtap="submitQuestionnaire">下一步</button>
      </view>
    </view>
  </view>

  <!-- 日期选择器弹窗（出生日期） -->
  <van-popup
    show="{{ showDatePicker }}"
    position="bottom"
    bind:close="onPopupClose"
  >
    <van-datetime-picker
      value="{{ currentDate }}"
      type="date"
      title="选择出生日期"
      min-date="{{ minDate }}"
      max-date="{{ maxDate }}"
      bind:input="onInput"
      bind:confirm="onDateConfirm"
      bind:cancel="onDateCancel"
      formatter="{{ formatter }}"
    />
  </van-popup>

  <!-- 目标日期选择器弹窗 -->
  <van-popup
    show="{{ showTargetDatePicker }}"
    position="bottom"
    bind:close="onTargetDatePopupClose"
  >
    <van-datetime-picker
      value="{{ targetDateTimestamp || targetMinDate }}"
      type="date"
      title="选择目标完成日期"
      min-date="{{ targetMinDate }}"
      max-date="{{ targetMaxDate }}"
      bind:confirm="onTargetDateConfirm"
      bind:cancel="onTargetDateCancel"
      formatter="{{ formatter }}"
    />
  </van-popup>
</view>
