.container {
  min-height: 100vh;
  background: #F7FAFC;
  padding: 24rpx;
  box-sizing: border-box;
}

.calendar-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.week-calendar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.calendar-arrow {
  padding: 10rpx;
  color: #CBD5E0;
}

.week-days {
  flex: 1;
  display: flex;
  justify-content: space-around;
  padding: 0 10rpx;
}

.day-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 100rpx;
  border-radius: 16rpx;
}

.day-item.today {
  color: var(--tomato-red);
}

.day-item.active {
  background: var(--tomato-red);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(239, 143, 65, 0.4);
}

.week-day-text {
  font-size: 22rpx;
  margin-bottom: 8rpx;
  opacity: 0.8;
}

.day-text {
  font-size: 32rpx;
  font-weight: 600;
}

/* Stats & List Section */
.stats-section {
  /* Remove container style to let children be separate cards */
  background: transparent;
  box-shadow: none;
  padding: 0;
  margin-bottom: 24rpx;
}

.stats-card.compact {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 0;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.1);
  position: relative;
  overflow: hidden;
}

.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: relative;
  z-index: 1;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-val {
  font-size: 72rpx;
  font-weight: 800;
  color: #2D3748;
  line-height: 1;
  margin-bottom: 12rpx;
  font-family: 'DIN Alternate', sans-serif;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

/* Add color distinction */
.stat-item .stat-val {
  background: var(--gradient-tomato);
  -webkit-background-clip: text;
  color: transparent;
}

.stat-val.red {
  background: linear-gradient(135deg, #FF9966 0%, #FF5E62 100%);
  -webkit-background-clip: text;
  color: transparent;
}

.stat-label {
  font-size: 26rpx;
  color: #718096;
  font-weight: 500;
  background: #F7FAFC;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: #EDF2F7;
}

/* Today List Compact */
.today-list {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-top: 24rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F7FAFC;
}

.list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3748;
  display: flex;
  align-items: center;
}

.list-title::before {
  content: '';
  display: block;
  width: 8rpx;
  height: 32rpx;
  background: var(--tomato-red);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.record-item.compact {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item.compact:last-child {
  border-bottom: none;
}

.record-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 50rpx;
  text-align: center;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 28rpx;
  color: #2D3748;
  font-weight: 500;
}

.record-detail {
  font-size: 22rpx;
  color: #A0AEC0;
  margin-top: 4rpx;
}

/* AI Button */
.ai-record-section {
  background: var(--gradient-tomato);
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 30rpx;
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(239, 143, 65, 0.3);
}

.ai-btn {
  display: flex;
  align-items: center;
}

.ai-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.ai-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.ai-arrow {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* Categories */
.category-group {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.category-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
}

.category-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2D3748;
}

.header-right {
  display: flex;
  align-items: center;
}

.category-hint {
  font-size: 24rpx;
  color: #CBD5E0;
  margin-right: 12rpx;
}

.exercise-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx 20rpx;
}

.exercise-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  box-sizing: border-box;
}

.ex-icon-box {
  width: 90rpx;
  height: 90rpx;
  background: #F7FAFC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.ex-icon {
  font-size: 44rpx;
}

.ex-name {
  font-size: 26rpx;
  color: #4A5568;
}

.delete-btn {
  color: var(--vibrant-orange);
  padding: 10rpx;
}


/* Popups */
.popup-header {
  text-align: center;
  padding-bottom: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3748;
}

.input-group {
  display: flex;
  align-items: center;
  background: #F7FAFC;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.duration-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: #2D3748;
  height: 60rpx;
}

.unit-text {
  font-size: 28rpx;
  color: #718096;
}

.estimate-info {
  text-align: center;
  color: var(--tomato-red);
  font-size: 26rpx;
  margin-bottom: 30rpx;
}

.confirm-btn {
  background: var(--gradient-tomato);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  height: 88rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* AI Popup */
.ai-popup {
  width: 600rpx;
  padding: 30rpx;
}

.ai-header {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #2D3748;
}

.ai-textarea {
  width: 100%;
  height: 200rpx;
  background: #F7FAFC;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.ai-submit-btn {
  background: var(--gradient-tomato);
  color: #fff;
  border-radius: 44rpx;
}

/* Result Popup */
.result-popup {
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
}

.result-header {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #2D3748;
}

.result-content {
  margin-bottom: 30rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F4FF;
}

.result-item .label {
  color: #718096;
  font-size: 28rpx;
  word-break: keep-all;
  width: 180rpx;
}

.result-item .value {
  color: #2D3748;
  font-weight: 500;
  font-size: 28rpx;
}

/* Loading */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E2E8F0;
  border-top-color: var(--tomato-red);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #4A5568;
}
