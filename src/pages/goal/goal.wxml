<!--pages/goal/goal.wxml-->
<view class="goal-page">
  <!-- 列表卡片 -->
  <view class="list-card">
    <!-- 身高 -->
    <view class="list-item" bindtap="onItemTap" data-field="height" data-type="number" data-title="身高" data-unit="cm">
      <text class="item-label">身高</text>
      <view class="item-right">
        <text class="item-value">{{profile.height || '--'}}</text>
        <text class="item-unit">cm</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 体重 -->
    <view class="list-item" bindtap="onItemTap" data-field="weight" data-type="number" data-title="体重" data-unit="kg">
      <text class="item-label">体重</text>
      <view class="item-right">
        <text class="item-value">{{profile.weight || '--'}}</text>
        <text class="item-unit">kg</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 年龄 -->
    <view class="list-item" bindtap="onItemTap" data-field="age" data-type="number" data-title="年龄" data-unit="岁">
      <text class="item-label">年龄</text>
      <view class="item-right">
        <text class="item-value">{{profile.age || '--'}}</text>
        <text class="item-unit">岁</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 性别 (Picker) -->
    <picker mode="selector" range="{{genderRange}}" value="{{genderIndex}}" bindchange="onGenderChange">
      <view class="list-item">
        <text class="item-label">性别</text>
        <view class="item-right">
          <text class="item-value">{{profile.gender || '男'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>
  </view>

  <view class="list-card margin-top">
    <!-- 目标体重 -->
    <view class="list-item" bindtap="onItemTap" data-field="targetWeight" data-type="number" data-title="目标体重" data-unit="kg">
      <text class="item-label">目标体重</text>
      <view class="item-right">
        <text class="item-value">{{goals.targetWeight || '--'}}</text>
        <text class="item-unit">kg</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 目标日期 (Date Picker) -->
    <picker mode="date" value="{{goals.targetDate}}" start="{{today}}" bindchange="onDateChange">
      <view class="list-item">
        <text class="item-label">目标日期</text>
        <view class="item-right">
          <text class="item-value">{{goals.targetDate || '请选择'}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 数值输入弹窗 (复用体重记录样式) -->
  <van-popup
    show="{{showInputPopup}}"
    position="bottom"
    round
    bind:close="closePopup"
  >
    <view class="input-popup">
      <view class="popup-header">
        <text class="popup-title">{{popupTitle}}</text>
      </view>

      <view class="input-container">
        <input
          class="popup-input"
          type="digit"
          value="{{inputValue}}"
          placeholder="请输入{{popupTitle}}"
          bindinput="onPopupInput"
          focus="{{showInputPopup}}"
        />
        <text class="input-unit">{{popupUnit}}</text>
      </view>

      <view class="popup-actions">
        <van-button
          type="default"
          size="large"
          custom-class="cancel-btn"
          bindtap="closePopup"
        >
          取消
        </van-button>
        <van-button
          type="primary"
          size="large"
          custom-class="save-btn"
          bindtap="savePopupInput"
        >
          保存
        </van-button>
      </view>
    </view>
  </van-popup>
</view>
