<!--pages/recipe-detail/recipe-detail.wxml-->
<view class="recipe-detail-page">
  <scroll-view scroll-y class="content-scroll" wx:if="{{!loading && recipeDetail}}">
    <!-- 食谱基本信息卡片 -->
    <view class="recipe-header-card recipe-header-bg-{{bgIndex}}">
      <view class="header-content">
        <!-- 收藏按钮 -->
        <view class="favorite-btn" bindtap="toggleFavorite">
          <text class="favorite-icon {{isFavorite ? 'favorited' : ''}}">{{isFavorite ? '★' : '☆'}}</text>
        </view>
        
        <view class="recipe-title">{{recipeDetail.name}}</view>
        <view class="recipe-desc">{{recipeDetail.promotion}}</view>
        
        <!-- 图片容器 -->
        <view class="header-image-container">
          <image class="header-image" src="{{recipeDetail.picUrl}}" mode="aspectFill" />
        </view>
      </view>
    </view>

    <!-- 天数选择器 -->
    <view class="day-selector-card" wx:if="{{dailyMeals.length > 0}}">
      <!-- 打卡进度条 -->
      <view class="check-in-progress" wx:if="{{checkInProgress}}">
        <view class="progress-header">
          <view class="progress-title">
            <text class="progress-icon">🏆</text>
            <text class="progress-name">打卡进度</text>
          </view>
        </view>
        
        <view class="progress-bar-container">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{checkInProgress.completionRate}}%"></view>
          </view>
        </view>
        
        <view class="progress-info">
          <text class="info-text">第{{checkInProgress.checkedDays}}天 / 共{{dailyMeals.length}}天</text>
          <text class="info-divider">•</text>
          <text class="info-text">完成度 {{checkInProgress.completionRate}}%</text>
        </view>
      </view>
      
      <!-- 天数选择滚动 -->
      <scroll-view scroll-x class="day-scroll" show-scrollbar="{{false}}">
        <view class="day-list">
          <view 
            wx:for="{{dailyMeals}}" 
            wx:key="id"
            class="day-item {{selectedDayId === item.id ? 'selected' : ''}} {{checkInProgress && checkInProgress.dayCheckStatus[item.dayNumber] ? 'checked-day' : ''}}"
            bindtap="selectDay"
            data-day-id="{{item.id}}"
          >
            <text class="day-name">{{item.dayName}}</text>
          </view>
        </view>
      </scroll-view>
      
      <!-- 打卡按钮 -->
      <view class="check-in-btn-container" wx:if="{{checkInProgress}}">
        <button 
          class="check-in-btn {{currentDayChecked ? 'checked' : ''}}"
          bindtap="onCheckIn"
          disabled="{{currentDayChecked}}"
        >
          {{currentDayChecked ? '已打卡 ✓' : '打卡第' + selectedDayNumber + '天'}}
        </button>
      </view>
    </view>

    <!-- 饮食安排 -->
    <view class="meal-plan-section" wx:if="{{meals.length > 0}}">
      <view 
        wx:for="{{meals}}" 
        wx:key="type"
        class="meal-card"
      >
        <view class="meal-header">
          <view class="meal-title-row">
            <view class="meal-icon-wrapper">
              <text class="meal-icon">{{item.icon}}</text>
            </view>
            <view class="meal-info">
              <text class="meal-calories" wx:if="{{item.calories > 0}}">{{item.calories}} kcal</text>
              <text class="meal-name">{{item.name}}</text>
            </view>
          </view>
        </view>
        
        <view class="food-grid">
          <view 
            wx:for="{{item.foods}}" 
            wx:key="index"
            wx:for-item="food"
            class="food-card"
          >
            <!-- 食物图片 -->
            <view class="food-image-wrapper">
              <image 
                wx:if="{{food.foodImgUrl}}" 
                class="food-image" 
                src="{{food.foodImgUrl}}" 
                mode="aspectFill"
              />
              <view wx:else class="food-image-placeholder">
                <text class="placeholder-icon">🍽️</text>
              </view>
            </view>
            
            <!-- 食物信息 -->
            <view class="food-content">
              <view class="food-name">{{food.foodName}}</view>
              <view class="food-meta">
                <text class="food-amount">{{food.foodCount}}{{food.unit}}</text>
                <text wx:if="{{food.foodCalories > 0}}" class="food-cal">{{food.foodCalories}}kcal</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 食谱介绍 -->
    <view class="recipe-intro-card" wx:if="{{recipeDetail.intro}}">
      <view class="intro-title">食谱介绍</view>
      <view class="intro-content">{{recipeDetail.intro}}</view>
    </view>

    <!-- 底部占位 -->
    <view style="height: 60rpx;"></view>
  </scroll-view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <van-loading type="spinner" size="48rpx" color="#E9503F">加载中...</van-loading>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && !recipeDetail}}">
    <text class="empty-icon">😕</text>
    <text class="empty-text">食谱不存在</text>
  </view>

  <!-- 开始选择弹窗 -->
  <view class="modal-mask" wx:if="{{showStartModal}}" catchtap="onCloseStartModal">
    <view class="modal-container" catchtap="stopPropagation">
      <view class="modal-content start-modal">
        <text class="modal-icon">🍽️</text>
        <text class="modal-title">开始你的饮食计划</text>
        
        <view class="modal-info" wx:if="{{checkInProgress && !checkInProgress.isCompleted}}">
          <text class="info-line">你上次打卡到：第{{checkInProgress.lastCheckedDay}}天（共{{checkInProgress.totalDays}}天）</text>
          <text class="info-line">完成度：{{checkInProgress.completionRate}}%</text>
        </view>
        
        <view class="modal-info" wx:if="{{checkInProgress && checkInProgress.isCompleted}}">
          <text class="info-line">🎊 你已完成全部打卡</text>
          <text class="info-line">开启新的挑战吧！</text>
        </view>
        
        <view class="modal-actions">
          <button 
            class="modal-btn primary" 
            bindtap="onContinueCheckIn"
            wx:if="{{!checkInProgress.isCompleted}}"
          >
            从第{{checkInProgress.nextDay}}天继续
          </button>
          <button class="modal-btn secondary" bindtap="onRestartCheckIn">
            重新开始（第1天）
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 打卡成功弹窗 -->
  <view class="modal-mask" wx:if="{{showCheckInModal}}" catchtap="onStayCurrent">
    <view class="modal-container" catchtap="stopPropagation">
      <view class="modal-content check-in-modal">
        <!-- 关闭按钮 -->
        <view class="modal-close" bindtap="onStayCurrent">
          <text class="close-icon">✕</text>
        </view>
        
        <text class="modal-icon celebrate">✨</text>
        <text class="modal-title">打卡成功！</text>
        
        <!-- 圆形进度环 -->
        <view class="progress-ring">
          <view class="ring-bg"></view>
          <view class="ring-progress" style="background: conic-gradient(#E9503F 0% {{checkInResult.completionRate}}%, #f7fafc {{checkInResult.completionRate}}% 100%)"></view>
          <view class="ring-inner">
            <text class="ring-percent">{{checkInResult.completionRate}}%</text>
          </view>
        </view>
        
        <view class="modal-stats">
          <view class="stat-item">
            <text class="stat-value">{{checkInResult.checkedDays}}</text>
            <text class="stat-label">已完成</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-value">{{checkInResult.totalDays - checkInResult.checkedDays}}</text>
            <text class="stat-label">剩余</text>
          </view>
        </view>
        
        <text class="encouragement-text">{{checkInResult.encouragement}}</text>
        
        <view class="modal-actions" wx:if="{{checkInResult.isCompleted}}">
          <button class="modal-btn primary" bindtap="onRestartAfterComplete">
            重新开始挑战
          </button>
        </view>
      </view>
    </view>
  </view>
</view>

