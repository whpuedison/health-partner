/* pages/recipe-detail/recipe-detail.wxss */
.recipe-detail-page {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 内容滚动区 */
.content-scroll {
  height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

/* 食谱头部卡片 */
.recipe-header-card {
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* 7个马卡龙纯色背景 */
.recipe-header-bg-0 {
  background: #FFB3BA; /* 粉红 */
}

.recipe-header-bg-1 {
  background: #FFDFBA; /* 桃色 */
}

.recipe-header-bg-2 {
  background: #FFFFBA; /* 柠檬黄 */
}

.recipe-header-bg-3 {
  background: #BAFFC9; /* 薄荷绿 */
}

.recipe-header-bg-4 {
  background: #BAE1FF; /* 天蓝 */
}

.recipe-header-bg-5 {
  background: #E0BBE4; /* 薰衣草紫 */
}

.recipe-header-bg-6 {
  background: #FFC9DE; /* 樱花粉 */
}

.header-content {
  position: relative;
  padding: 40rpx 32rpx 0;
}

/* 收藏按钮 */
.favorite-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  z-index: 10;
}

.favorite-btn:active {
  transform: scale(0.9);
}

.favorite-icon {
  font-size: 40rpx;
  color: #fff;
  transition: all 0.3s;
}

.favorite-icon.favorited {
  color: var(--tomato-red);
  text-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.4);
}

.recipe-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 12rpx;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}

.recipe-desc {
  font-size: 26rpx;
  color: #4a5568;
  line-height: 1.5;
  opacity: 0.85;
  font-weight: 400;
  margin-bottom: 24rpx;
}

/* 图片容器 */
.header-image-container {
  position: relative;
  width: 70%;
  margin: 0 auto;
  height: 320rpx;
  overflow: hidden;
  border-radius: 16rpx 16rpx 0 0;
}

.header-image {
  width: 100%;
  height: 430rpx;
  object-fit: cover;
  object-position: center top;
  display: block;
  border-radius: 30%;
}

/* 天数选择器卡片 */
.day-selector-card {
  width: 100%;
  background: var(--white);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.day-scroll {
  width: 100%;
  white-space: nowrap;
}

.day-list {
  display: inline-flex;
  gap: 12rpx;
}

.day-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
  flex-shrink: 0;
}

.day-item.selected {
  background: var(--tomato-red);
  box-shadow: 0 4rpx 12rpx rgba(233, 80, 63, 0.3);
}

.day-item.selected .day-name {
  color: white;
}

.day-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2d3748;
  white-space: nowrap;
}

/* 饮食安排区域 */
.meal-plan-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.meal-card {
  background: var(--white);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.meal-header {
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #FFFBF7 0%, #FFF5F0 100%);
  border-bottom: 1rpx solid rgba(233, 80, 63, 0.08);
}

.meal-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.meal-icon-wrapper {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFE8E0 0%, #FFD4C4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(233, 80, 63, 0.15);
}

.meal-icon {
  font-size: 32rpx;
}

.meal-info {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12rpx;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a202c;
  letter-spacing: 0.5rpx;
}

.meal-calories {
  font-size: 22rpx;
  color: var(--tomato-red);
  font-weight: 600;
  opacity: 0.9;
}

/* 食物网格 */
.food-grid {
  padding: 16rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.food-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  background: #FAFBFC;
  border-radius: 14rpx;
  transition: all 0.3s;
}

.food-card:active {
  background: #F5F7FA;
  transform: scale(0.98);
}

/* 食物图片 */
.food-image-wrapper {
  flex-shrink: 0;
}

.food-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.food-image-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #FFF9F0 0%, #FFEFE0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.placeholder-icon {
  font-size: 40rpx;
  opacity: 0.4;
}

/* 食物内容 */
.food-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.food-name {
  font-size: 26rpx;
  color: #2d3748;
  font-weight: 600;
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.food-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.food-amount {
  font-size: 22rpx;
  color: #718096;
  font-weight: 500;
  padding: 4rpx 12rpx;
  background: rgba(113, 128, 150, 0.08);
  border-radius: 8rpx;
  white-space: nowrap;
}

.food-cal {
  font-size: 22rpx;
  color: var(--tomato-red);
  font-weight: 600;
  padding: 4rpx 12rpx;
  background: rgba(233, 80, 63, 0.08);
  border-radius: 8rpx;
  white-space: nowrap;
}

/* 食谱介绍卡片 */
.recipe-intro-card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 24rpx;
}

.intro-content {
  font-size: 28rpx;
  color: #718096;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #718096;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #718096;
}

