/* pages/recipe-detail/recipe-detail.wxss */
.recipe-detail-page {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 内容滚动区 */
.content-scroll {
  height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

/* 食谱头部卡片 */
.recipe-header-card {
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* 7个马卡龙纯色背景 */
.recipe-header-bg-0 {
  background: #FFB3BA; /* 粉红 */
}

.recipe-header-bg-1 {
  background: #FFDFBA; /* 桃色 */
}

.recipe-header-bg-2 {
  background: #FFFFBA; /* 柠檬黄 */
}

.recipe-header-bg-3 {
  background: #BAFFC9; /* 薄荷绿 */
}

.recipe-header-bg-4 {
  background: #BAE1FF; /* 天蓝 */
}

.recipe-header-bg-5 {
  background: #E0BBE4; /* 薰衣草紫 */
}

.recipe-header-bg-6 {
  background: #FFC9DE; /* 樱花粉 */
}

.header-content {
  padding: 40rpx 32rpx 0;
}

.recipe-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 12rpx;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}

.recipe-desc {
  font-size: 26rpx;
  color: #4a5568;
  line-height: 1.5;
  opacity: 0.85;
  font-weight: 400;
  margin-bottom: 24rpx;
}

/* 图片容器 */
.header-image-container {
  position: relative;
  width: 70%;
  margin: 0 auto;
  height: 320rpx;
  overflow: hidden;
  border-radius: 16rpx 16rpx 0 0;
}

.header-image {
  width: 100%;
  height: 400rpx;
  object-fit: cover;
  object-position: center top;
  display: block;
}

/* 天数选择器卡片 */
.day-selector-card {
  width: 100%;
  background: var(--white);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.day-scroll {
  width: 100%;
  white-space: nowrap;
}

.day-list {
  display: inline-flex;
  gap: 12rpx;
}

.day-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
  flex-shrink: 0;
}

.day-item.selected {
  background: var(--tomato-red);
  box-shadow: 0 4rpx 12rpx rgba(233, 80, 63, 0.3);
}

.day-item.selected .day-name {
  color: white;
}

.day-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2d3748;
  white-space: nowrap;
}

/* 饮食安排卡片 */
.meal-plan-card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.meal-section {
  margin-bottom: 40rpx;
}

.meal-section:last-child {
  margin-bottom: 0;
}

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFFBF7 100%);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.meal-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meal-icon {
  font-size: 40rpx;
}

.meal-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d3748;
}

.meal-calories {
  font-size: 26rpx;
  color: var(--tomato-red);
  font-weight: 600;
}

.food-list {
  padding: 0 12rpx;
}

.food-item {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #f5f7fa;
  gap: 20rpx;
}

.food-item:last-child {
  border-bottom: none;
}

/* 食物图片 */
.food-image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  flex-shrink: 0;
}

.food-image-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFFBF7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.placeholder-text {
  font-size: 48rpx;
  opacity: 0.5;
}

/* 食物信息 */
.food-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 96rpx;
}

.food-name {
  font-size: 30rpx;
  color: #2d3748;
  font-weight: 600;
  line-height: 1.4;
  flex: 1;
  padding-right: 20rpx;
}

.food-detail {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.food-amount {
  font-size: 22rpx;
  color: #718096;
}

.food-cal {
  font-size: 22rpx;
  color: var(--tomato-red);
  letter-spacing: 0.5rpx;
}

/* 食谱介绍卡片 */
.recipe-intro-card {
  background: var(--white);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 24rpx;
}

.intro-content {
  font-size: 28rpx;
  color: #718096;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #718096;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #718096;
}

