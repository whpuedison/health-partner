.goal-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx;
}

/* 列表卡片 */
.list-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.margin-top {
  margin-top: 24rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: #f9f9f9;
}

.item-label {
  font-size: 30rpx;
  color: #2d3748;
}

.item-right {
  display: flex;
  align-items: center;
}

.item-value {
  font-size: 30rpx;
  color: #2d3748;
  font-weight: 500;
}

.item-unit {
  font-size: 26rpx;
  color: #718096;
  margin-left: 8rpx;
}

.arrow {
  margin-left: 16rpx;
  color: #cbd5e0;
  font-size: 32rpx;
}

/* 弹窗样式 */
.input-popup {
  padding: 40rpx 32rpx;
  background: white;
}

.popup-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2d3748;
}

.input-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  padding: 32rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.popup-input {
  font-size: 36rpx;
  color: #2d3748;
  text-align: center;
  width: 300rpx;
  height: 60rpx;
}

.input-unit {
  font-size: 36rpx;
  color: #718096;
  margin-left: 16rpx;
}

.popup-actions {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.cancel-btn {
  width: 340rpx !important; 
  background: #f5f7fa !important;
  color: #718096 !important;
  border: none !important;
  border-radius: 16rpx !important;
}

.save-btn {
  width: 340rpx !important; 
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%) !important;
  border: none !important;
  color: white !important;
  border-radius: 16rpx !important;
}

