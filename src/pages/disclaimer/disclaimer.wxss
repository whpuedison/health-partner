
.container {
  padding: 30rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.content {
  font-size: 28rpx;
  line-height: 1.8;
  text-align: justify;
}

.paragraph {
  margin-bottom: 24rpx;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.footer {
  margin-top: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #19be6b;
  font-weight: 500;
  letter-spacing: 2rpx;
}