.container {
  padding: 30rpx;
  background-color: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #444;
  text-align: center;
  margin-bottom: 40rpx;
}

.content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #444;
  text-align: justify;
}

.paragraph {
  margin-bottom: 24rpx;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.footer {
  margin-top: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #19be6b;
  font-weight: 500;
  letter-spacing: 2rpx;
}