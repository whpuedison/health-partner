/* pages/index/index.wxss */
.index-page {
  min-height: 100vh;
  background: #fff;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 通用卡片样式 - Glassmorphism */
.dashboard-card {
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid #B8E6C8;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 135, 0.05);
  /* border: 1rpx solid rgba(255, 255, 255, 0.8); */
}

/* 1. 体重进度卡片 */
.weight-card {
  background: none;
  border: none;
  box-shadow: none;
  padding-top: 28rpx;
}

.card-header {
  display: flex;
  justify-content: center;
  column-gap:40rpx;
  align-items: flex-end;
  margin-bottom: 40rpx;
}

.weight-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.weight-col.current {
    width: 320rpx;
    height: 320rpx;
    flex-shrink: 0;
    background: linear-gradient(135deg, #e0f7fa 0%, #e8f5e9 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

/* 外部装饰圆 - 保持原有 */
.weight-col.current::before {
  content: "";
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(168, 224, 218, 0.1), rgba(18, 212, 95, 0.1));
  border: 1rpx solid #e8f5e9;
  z-index: -1;
}

.weight-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.05);
  margin-top: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-bottom: 8rpx;
}

.value {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  font-family: 'DIN Alternate', sans-serif;
}

.weight-col.current .value {
  font-size: 64rpx;
  color: #009688;
}

.value-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.diff-tag {
  font-size: 30rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.diff-tag.down {
  color: #009688;
  background: rgba(0, 150, 136, 0.1);
}

.diff-tag.up {
  color: #ff5252;
  background: rgba(255, 82, 82, 0.1);
}

.sub-value.bmi {
  font-size: 24rpx;
  color: #95a5a6;
  margin-top: 8rpx;
  background: rgba(0, 0, 0, 0.05);
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.sub-value.bmi.active {
  background: #E0F2F1;
  color: #009688;
}

.progress-section {
  width: 100%;
  margin:64rpx auto 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.progress-bar-container {
  height: 16rpx;
  position: relative;
  display: flex;
  align-items: center;
}

.progress-track {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: #E0E0E0;
  border-radius: 8rpx;
}

.progress-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #4DB6AC, #009688);
  border-radius: 8rpx;
  transition: width 1s ease-out;
}

.progress-knob {
  position: absolute;
  right: -8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 24rpx;
  height: 24rpx;
  background: #fff;
  border: 4rpx solid #009688;
  border-radius: 50%;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.progress-percent {
  position: absolute;
  right: 0;
  top: -42rpx;
  font-size: 24rpx;
  color: #009688;
  font-weight: bold;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #7f8c8d;
}

/* 2. 热量平衡卡片 */
.grid-3-col {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.vertical-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.05);
}

.unit {
  font-size: 20rpx;
  color: #95a5a6;
  margin-top: 4rpx;
}

.grid-item .value {
  font-size: 36rpx;
}

.grid-item .value.good { color: #009688; }
.grid-item .value.bad { color: #FF9800; }

.card-footer-info {
  background: rgba(255, 255, 255, 0.4);
  padding: 16rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
}

.info-tag { color: #546E7A; }
.info-highlight { color: #E65100; font-weight: 600; }

/* 3. 营养构成卡片 */
.grid-4-col {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.grid-4-col .grid-item .value {
  font-size: 32rpx;
}

.grid-4-col .grid-item.highlight .value {
  font-size: 40rpx;
  color: #009688;
}

.percent {
  font-size: 20rpx;
  color: #95a5a6;
}

.bars-container {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mini-bar-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  font-size: 20rpx;
  color: #7f8c8d;
  text-align: center;
}

.mini-bar {
  height: 12rpx;
  background: #F5F5F5;
  border-radius: 6rpx;
  overflow: hidden;
  width: 100%;
}

.mini-bar .fill {
  height: 100%;
  border-radius: 6rpx;
}

.mini-bar.carbs .fill { background: #FFCC80; }
.mini-bar.protein .fill { background: #81C784; }
.mini-bar.fat .fill { background: #90CAF9; }
.mini-bar.total .fill { background: #FF7043; }

.advice-box {
  background: #E8F5E9;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #2E7D32;
  line-height: 1.4;
}

/* 4 & 5. 记录列表卡片 */
.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}

.divider-line {
  height: 1rpx;
  background: rgba(0,0,0,0.05);
  margin-bottom: 24rpx;
}

.meal-section {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #546E7A;
  margin-bottom: 12rpx;
}

.head-title { font-weight: 600; }

.food-item {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #78909C;
  padding-left: 16rpx;
  margin-bottom: 8rpx;
}

.total-summary {
  margin-top: 16rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #009688;
}

.empty-state {
  text-align: center;
  padding: 40rpx 0;
  color: #B0BEC5;
  font-size: 26rpx;
}

/* 快捷入口按钮 */
.quick-entry-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.ai-btn {
  flex: 1;
  height: 72rpx;
  background: #E0F2F1;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #009688;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 150, 136, 0.1);
}

.ai-btn.camera {
  background: #E3F2FD;
  color: #1976D2;
  box-shadow: 0 4rpx 12rpx rgba(25, 118, 210, 0.1);
}


.ai-btn.full {
  width: 100%;
}

/* Share Card */
.share-card {
  position: relative;
  background: linear-gradient(-45deg, rgb(194, 241, 90), rgb(238, 253, 166));
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 195, 74, 0.2);
}

/* Invisible button that covers the whole card or just the button? 
   Requirement says "Click the card's button to share". 
   Let's make the "action-btn" the visual trigger, but maybe overlap a button?
   Actually, usually better to wrap the visual button in a real button, 
   or place a transparent button over the whole card if the whole card is clickable.
   The WXML I wrote has a .share-btn-overlay covering the WHOLE card.
*/
.share-btn-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 10;
}

.bubble-tip {
  display: inline-block;
  background: #fff;
  color: #000;
  font-size: 26rpx;
  font-weight: bold;
  padding: 12rpx 24rpx;
  border-radius: 40rpx; /* more rounded */
  border: 2rpx solid #000;
  position: relative;
  /* slight tilt */
  transform: rotate(-2deg);
  box-shadow: 2rpx 2rpx 0rpx #000;
  margin-bottom: 16rpx;
  z-index: 2; /* above particles */
}

/* Triangle for speech bubble */
.bubble-tip::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 40rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #fff;
  /* Border trickery for outlined triangle is hard with CSS alone, 
     often simplified or requires SVG/complex pseudo elements. 
     Keeping simple for now. */
}

.content-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
  z-index: 2;
  position: relative;
}

.text-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  /* slight tilt up */
  transform: rotate(-3deg); 
}

.text-white {
  font-size: 48rpx;
  color: #fff;
  font-weight: 900;
  /* Text stroke effect */
  text-shadow: 
    2rpx 2rpx 0 #000,
    -1rpx -1rpx 0 #000,  
    1rpx -1rpx 0 #000,
    -1rpx 1rpx 0 #000,
    1rpx 1rpx 0 #000;
  font-style: italic;
}

.text-orange {
  font-size: 56rpx;
  color: #FF6D00;
  font-weight: 900;
  text-shadow: 
    2rpx 2rpx 0 #fff,
    -2rpx -2rpx 0 #fff,  
    2rpx -2rpx 0 #fff,
    -2rpx 2rpx 0 #fff;
  font-style: italic;
}

.action-btn {
  width: fit-content !important;
  background: linear-gradient(180deg, rgb(238,124,64), #ff9800);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(213, 113, 13, 0.3);
  display: flex;
  align-items: center;
  gap: 8rpx;
  
  /* Reset button styles */
  margin: 0;
  line-height: normal;
}
.action-btn::after {
  display: none;
}

.arrow {
  font-family: monospace;
}

.s1 { top: 20%; left: 10%; opacity: 0.8; transform: scale(0.8); }
.s2 { bottom: 20%; right: 10%; opacity: 0.6; animation-delay: 1s; }

@keyframes twinkle {
  0%, 100% { transform: scale(0.8); opacity: 0.6; }
  50% { transform: scale(1.2); opacity: 1; }
}

/* Lock Overlay */
.list-card {
  position: relative; /* For overlay positioning */
}

.locked-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.4); /* Semi-transparent white */
  backdrop-filter: blur(1px);
  z-index: 10;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 32rpx; /* Match card radius */
  color: #7f8c8d;
  font-size: 28rpx;
}

.lock-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}


