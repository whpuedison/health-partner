/* pages/index/index.wxss */
.index-page {
  min-height: 100vh;
  background: var(--bg-light);
  /* padding: 24rpx; <- 移除全局 padding，改为内容区单独设置 */
  box-sizing: border-box;
}

/* ==================== 1. 沉浸式头部 (原体重卡片) ==================== */
.header-section {
  background: var(--gradient-tomato);
  /* 移除 margin和圆角，改为全屏 */
  padding: 48rpx 24rpx 100rpx; /* 底部增加 padding 留给悬浮层 */
  color: var(--white);
  /* 底部弧度 */
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  box-shadow: 0 4rpx 20rpx rgba(233, 80, 63, 0.2);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end; /* 底部对齐 */
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.weight-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 两侧小数据 */
.weight-col.small .label {
    font-size: 22rpx;
    opacity: 0.8;
    margin-bottom: 4rpx;
}
.weight-col.small .value-sm {
    font-size: 32rpx;
    font-weight: 600;
}

/* 中间大数据 */
.weight-col.current {
    transform: translateY(-10rpx); /* 微调向上 */
}
.weight-col.current .label {
    font-size: 24rpx;
    opacity: 0.9;
    margin-bottom: 4rpx;
}
.weight-col.current .value-lg {
    font-size: 72rpx; /* 放大 */
    font-weight: 900;
    line-height: 1;
    margin-bottom: 12rpx;
}

.tag-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.diff-tag {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.2);
  color: var(--white);
}

.bmi-tag {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.9);
}

/* 进度条 - 保持简洁 */
.progress-section {
  padding: 0 16rpx;
}

.progress-bar-container {
  height: 10rpx;
  position: relative;
  margin-bottom: 12rpx;
}

.progress-track {
  position: absolute;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
}

.progress-fill {
  position: absolute;
  height: 100%;
  background: var(--white);
  border-radius: 6rpx;
  transition: width 0.8s ease-out;
}

.progress-knob {
  position: absolute;
  right: -6rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 16rpx;
  background: var(--white);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ==================== 悬浮内容区 ==================== */
.content-wrapper {
    padding: 0 24rpx;
    margin-top: -75rpx; /* 核心：负边距实现悬浮 */
    position: relative;
    z-index: 2;
    padding-bottom: 60rpx;
}


/* ==================== 通用卡片样式 ==================== */
.dashboard-card {
  background: #FFFBF7;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: val(--gray-dark);
  line-height: 1;
}

.title-right {
    display: flex;
    align-items: center;
    font-size: 24rpx;
    color: var(--gray-light);
    gap: 8rpx;
}

.total-cal {
    color: var(--tomato-red);
    font-weight: 600;
}

.divider-line {
  height: 1rpx; /* Slightly thicker */
  background: #F0F0F0; /* Tomato tint divider */
  margin-bottom: 16rpx;
}


/* ==================== 2. 饮食列表 (折叠手风琴) ==================== */
.list-card {
  position: relative;
}

.meal-accordion {
    border-bottom: 1rpx solid #F8F8F8;
}

.meal-accordion:last-child {
    border-bottom: none;
}

.accordion-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
}

.head-left {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.meal-icon { font-size: 32rpx; }
.head-title { 
    font-size: 28rpx; 
    font-weight: 500; 
    color: var(--gray-dark);
}

.head-right {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.head-cal {
    font-size: 26rpx;
    color: var(--vibrant-orange); /* Highlight data points */
}

.accordion-content {
    height: 0;
    overflow: hidden;
    transition: height 0.3s ease-out;
    background: #FAFAFA;
}

/* 简单的展开高度逻辑：auto 不支持 transition，这里用 max-height 模拟 */
.accordion-content.expanded {
    height: auto;
    padding: 12rpx 16rpx;
    border-radius: 8rpx;
    margin-bottom: 12rpx;
}

.food-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx; /* Slightly larger */
  color: var(--gray-dark); /* Darker for readability */
  padding: 8rpx 0;
}

.food-cal {
  color: var(--gray-medium); /* Highlight data points */
}

.empty-state {
  text-align: center;
  color: var(--gray-light);
  font-size: 26rpx;
}

.diet-icon {
  width: 270rpx !important;
}
/* 快捷入口按钮 */
.quick-entry-row {
  display: flex;
  gap: 16rpx;
}

.ai-btn {
  flex: 1;
  height: 72rpx;
  background: var(--pale-orange);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--tomato-red);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(233, 80, 63, 0.1);
  transition: all 0.3s;
}

.ai-btn:active {
  transform: scale(0.98);
  background: var(--light-orange);
}

.ai-btn.camera, .ai-btn.sport {
  background: var(--gradient-orange);
  color: var(--white);
  box-shadow: 0 4rpx 12rpx rgba(239, 143, 65, 0.25);
}

.ai-btn.full {
  width: 100%;
}

/* ==================== 分享卡片 (复古气泡版) ==================== */
.share-card {
  position: relative;
  background: var(--gradient-tomato); 
  border-radius: 20rpx;
  padding: 24rpx 40rpx; /* 增加一点内边距以容纳气泡 */
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  overflow: visible; /* 允许气泡溢出(如果有) 或者保持 hidden */
  /* previous was overflow: hidden, let's keep it clean unless bubble pops out. 
     The bubble is inside, so it's fine. */
  overflow: hidden;
}

.share-btn-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 10;
}

.bubble-tip {
  display: inline-block;
  background: var(--white);
  color: var(--tomato-red);
  font-size: 24rpx;
  font-weight: bold;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  transform: rotate(-1deg); /* 微微倾斜增加俏皮感 */
}

/* 气泡小三角 */
.bubble-tip::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 30rpx;
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid var(--white);
}

.content-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  transform: rotate(-2deg); /* 之前的动态倾斜 */
}

.text-white {
  font-size: 32rpx;
  color: var(--white);
  font-weight: bold;
  font-style: italic;
  text-shadow: 2rpx 2rpx 0 rgba(0,0,0,0.1);
}

.text-orange {
  font-size: 40rpx;
  color: #FFE0B2; /* 浅橙色，在红背景下对比度高 */
  font-weight: 900;
  font-style: italic;
  text-shadow: 2rpx 2rpx 0 rgba(0,0,0,0.1);
}

.action-btn {
  width: fit-content !important;
  margin: 0 !important;
  background: var(--white);
  color: var(--tomato-red);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* ==================== 3. 热量平衡 (可视化) ==================== */
.calorie-card {
  background: #FFFBF7; /* 极浅橙背景 */
}

/* ==================== 2. 热量平衡卡片 (Grid) ==================== */
.grid-3-col {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 12rpx 24rpx;
  margin-bottom: 12rpx;
  background: rgba(233, 80, 63, 0.05); /* 淡淡的番茄色背景 */
  border-radius: 12rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bold {
  font-weight: bold;
  font-size: 32rpx;
}

.vertical-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.05);
}

.unit {
  font-size: 20rpx;
  color: var(--gray-light);
  margin-top: 4rpx;
}

.grid-item .value {
  color: var(--gray-dark);
}

.card-footer-info {
  padding: 16rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
}

.info-tag { color: var(--gray-medium); }
.info-highlight { color: var(--tomato-red); font-weight: 600; }

/* ==================== 4. 营养构成卡片 (Grid + Mini Bars) ==================== */
.nutrition-card {
    background: #FFFBF7; /* Same as calorie card for visual continuity */
}

.grid-4-col {
  display: flex;
  justify-content: space-between;
}

.grid-4-col .grid-item.highlight .value {
  font-size: 40rpx;
  color: var(--tomato-red);
}

.percent {
  font-size: 20rpx;
  color: var(--gray-light);
}

.bars-container {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mini-bar-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  font-size: 20rpx;
  color: var(--gray-medium);
  text-align: center;
}

.mini-bar {
  height: 12rpx;
  background: #F5F5F5;
  border-radius: 6rpx;
  overflow: hidden;
  width: 100%;
}

.mini-bar .fill {
  height: 100%;
  border-radius: 6rpx;
}

/* 自然食欲配色 */
.mini-bar.carbs .fill { background: #E6A23C; }    /* 暖橙 */
.mini-bar.protein .fill { background: #FADB14; }  /* 蛋黄 */
.mini-bar.fat .fill { background: #F56C6C; }      /* 淡红 */
.mini-bar.total .fill { background: var(--gradient-tomato); } /* 番茄红 */

.advice-box {
  background: var(--pale-orange);
  border-left: 4rpx solid var(--vibrant-orange);
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--gray-dark);
  margin-top: 24rpx;
}

/* 锁定遮罩 */
.locked-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.1); 
  backdrop-filter: blur(1px);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 20rpx;
  color: var(--tomato-red);
  font-weight: 600;
  font-size: 28rpx;
}

.lock-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx
}


