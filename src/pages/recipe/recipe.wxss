/* pages/recipe/recipe.wxss */
.recipe-page {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
}

/* 侧边栏 */
.sidebar {
  width: 160rpx;
  height: 100vh;
  background: var(--white);
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.03);
}

.sidebar-item {
  position: relative;
  padding: 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.sidebar-text {
  font-size: 26rpx;
  color: #718096;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}

.sidebar-item.active .sidebar-text {
  color: var(--tomato-red);
  font-weight: 600;
}

.active-indicator {
  position: absolute;
  left: 0;
  width: 6rpx;
  height: 32rpx;
  background: var(--gradient-tomato);
  border-radius: 0 6rpx 6rpx 0;
}

/* 内容区域 */
.content-area {
  flex: 1;
  height: 100vh;
}

/* 食谱列表 */
.recipe-list {
  height: 100%;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.recipe-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.recipe-card {
  background: transparent;
  transition: all 0.3s;
}

.recipe-card:active {
  transform: scale(0.98);
}

/* 内容卡片 */
.recipe-content-card {
  position: relative;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

/* 7个马卡龙纯色背景 */
.recipe-card-bg-0 .recipe-content-card {
  background: #FFB3BA; /* 粉红 */
}

.recipe-card-bg-1 .recipe-content-card {
  background: #FFDFBA; /* 桃色 */
}

.recipe-card-bg-2 .recipe-content-card {
  background: #FFFFBA; /* 柠檬黄 */
}

.recipe-card-bg-3 .recipe-content-card {
  background: #BAFFC9; /* 薄荷绿 */
}

.recipe-card-bg-4 .recipe-content-card {
  background: #BAE1FF; /* 天蓝 */
}

.recipe-card-bg-5 .recipe-content-card {
  background: #E0BBE4; /* 薰衣草紫 */
}

.recipe-card-bg-6 .recipe-content-card {
  background: #FFC9DE; /* 樱花粉 */
}

.recipe-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 12rpx;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}

.recipe-promotion {
  font-size: 24rpx;
  color: #4a5568;
  line-height: 1.5;
  opacity: 0.85;
  font-weight: 400;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 图片容器 */
.recipe-image-container {
  position: relative;
  width: 70%;
  margin: 0 auto;
  height: 280rpx;
  overflow: hidden;
  border-radius: 16rpx 16rpx 0 0;
}

.recipe-image {
  width: 100%;
  height: 350rpx;
  object-fit: cover;
  object-position: center top;
  display: block;
  border-radius: 30%;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #718096;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #718096;
}

