/* pages/recipe/recipe.wxss */
.recipe-page {
  min-height: 100vh;
  background: #f5f7fa;
  display: flex;
}

/* 侧边栏 */
.sidebar {
  width: 160rpx;
  height: 100vh;
  background: var(--white);
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.03);
}

.sidebar-item {
  position: relative;
  padding: 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.sidebar-text {
  font-size: 26rpx;
  color: #718096;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}

.sidebar-item.active .sidebar-text {
  color: var(--tomato-red);
  font-weight: 600;
}

.active-indicator {
  position: absolute;
  left: 0;
  width: 6rpx;
  height: 32rpx;
  background: var(--gradient-tomato);
  border-radius: 0 6rpx 6rpx 0;
}

/* 内容区域 */
.content-area {
  flex: 1;
  height: 100vh;
}

/* 食谱列表 */
.recipe-list {
  height: 100%;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.recipe-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.recipe-card {
  background: transparent;
  transition: all 0.3s;
}

.recipe-card:active {
  transform: scale(0.98);
}

.card-inner {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.recipe-image {
  width: 100%;
  height: 380rpx;
  background: #f5f7fa;
}

.recommend-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: var(--white);
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.recipe-info {
  padding: 32rpx;
}

.recipe-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.recipe-promotion {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #718096;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #718096;
}

