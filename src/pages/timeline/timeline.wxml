<!--pages/timeline/timeline.wxml-->
<view class="timeline-page">
  <!-- 发布按钮 -->
  <view wx:if="{{false}}" class="create-btn" bindtap="goToCreate">
    <text class="create-icon">✏️</text>
    <text class="create-text">发布</text>
  </view>

  <!-- 帖子列表 -->
  <view class="posts-list">
    <view class="post-item" wx:for="{{posts}}" wx:key="id">
      <!-- 用户信息 -->
      <view class="post-header">
        <image class="user-avatar" src="{{item.avatar_url || '/static/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="user-info">
          <text class="user-name">{{item.nickname || '匿名用户'}}</text>
          <text class="post-time">{{item.created_at}}</text>
        </view>
        <!-- 时光轴中所有帖子都显示删除按钮 -->
        <view class="post-actions">
          <text class="delete-btn" data-id="{{item.id}}" bindtap="deletePost">删除</text>
        </view>
      </view>

      <!-- 帖子内容 -->
      <view class="post-content">
        <text class="content-text">{{item.content}}</text>
      </view>

      <!-- 帖子图片 -->
      <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
        <!-- 单张图片 -->
        <view class="images-grid images-single" wx:if="{{item.images.length === 1}}">
          <view class="image-single-wrapper">
            <image 
              class="image-single" 
              src="{{item.images[0]}}" 
              mode="heightFix"
              data-url="{{item.images[0]}}"
              data-urls="{{item.images}}"
              bindtap="previewImage"
            ></image>
          </view>
        </view>
        <!-- 2张图片 -->
        <view class="images-grid images-2" wx:elif="{{item.images.length === 2}}">
          <view 
            class="image-item" 
            wx:for="{{item.images}}" 
            wx:key="*this"
            wx:for-item="img"
            data-url="{{img}}"
            data-urls="{{item.images}}"
            bindtap="previewImage"
          >
            <image 
              src="{{img}}" 
              mode="aspectFill"
            ></image>
          </view>
        </view>
        <!-- 3-4张图片：2x2网格 -->
        <view class="images-grid images-4" wx:elif="{{item.images.length <= 4}}">
          <view 
            class="image-item" 
            wx:for="{{item.images}}" 
            wx:key="*this"
            wx:for-item="img"
            data-url="{{img}}"
            data-urls="{{item.images}}"
            bindtap="previewImage"
          >
            <image 
              src="{{img}}" 
              mode="aspectFill"
            ></image>
          </view>
        </view>
        <!-- 5-6张图片：3列 -->
        <view class="images-grid images-6" wx:elif="{{item.images.length <= 6}}">
          <view 
            class="image-item" 
            wx:for="{{item.images}}" 
            wx:key="*this"
            wx:for-item="img"
            data-url="{{img}}"
            data-urls="{{item.images}}"
            bindtap="previewImage"
          >
            <image 
              src="{{img}}" 
              mode="aspectFill"
            ></image>
          </view>
        </view>
        <!-- 7-9张图片：3x3网格 -->
        <view class="images-grid images-9" wx:else>
          <view 
            class="image-item" 
            wx:for="{{item.images}}" 
            wx:key="*this"
            wx:for-item="img"
            data-url="{{img}}"
            data-urls="{{item.images}}"
            bindtap="previewImage"
          >
            <image 
              src="{{img}}" 
              mode="aspectFill"
            ></image>
          </view>
        </view>
      </view>

      <!-- 互动区域：点赞和评论 -->
      <view class="post-actions-bar">
        <view class="action-item" wx:if="{{item.powerEnable !== false && false}}" bindtap="toggleLike" data-id="{{item.id}}">
          <text class="action-icon {{item.isLiked ? 'liked' : ''}}">{{item.isLiked ? '❤️' : '🤍'}}</text>
          <text class="action-text">{{item.likeCount || 0}}</text>
        </view>
        <view class="action-item" wx:if="{{item.powerEnable !== false && false}}" bindtap="toggleComments" data-id="{{item.id}}">
          <text class="action-icon">💬</text>
          <text class="action-text">{{item.commentCount || 0}}</text>
        </view>
      </view>

      <!-- 评论列表 -->
      <view class="comments-section" wx:if="{{item.showComments}}">
        <!-- 评论输入框 -->
        <view class="comment-input-box" wx:if="{{item.showCommentInput}}">
          <view class="comment-input-hint" wx:if="{{item.commentInput && item.commentInput.replyToNickname}}">
            回复 {{item.commentInput.replyToNickname}}：
          </view>
          <view class="comment-input-row">
            <input 
              class="comment-input" 
              placeholder="写评论..."
              value="{{item.commentInput && item.commentInput.content}}"
              data-id="{{item.id}}"
              bindinput="onCommentInput"
              confirm-type="send"
              bindconfirm="submitComment"
            />
            <text class="comment-submit" data-id="{{item.id}}" bindtap="submitComment">发送</text>
            <text class="comment-cancel" data-id="{{item.id}}" bindtap="hideCommentInput">取消</text>
          </view>
        </view>
        
        <!-- 评论列表 -->
        <view class="comments-list" wx:if="{{item.comments && item.comments.length > 0}}">
          <view class="comment-item" wx:for="{{item.comments}}" wx:key="id" wx:for-item="comment">
            <!-- 一级评论 -->
            <view class="comment-main" bindlongpress="onCommentLongPress" data-post-id="{{item.id}}" data-comment-id="{{comment.id}}" data-user-id="{{comment.userId}}">
              <image class="comment-avatar" src="{{comment.avatarUrl || '/static/default-avatar.png'}}" mode="aspectFill"></image>
              <view class="comment-content">
                <view class="comment-header">
                  <text class="comment-name">{{comment.nickname}}</text>
                </view>
                <text class="comment-text">{{comment.content}}</text>
                <view class="comment-actions">
                  <text class="comment-time">{{comment.created_at}}</text>
                  <text class="comment-reply" data-id="{{item.id}}" data-parent-id="{{comment.id}}" data-reply-to-user-id="{{comment.userId}}" data-reply-to-nickname="{{comment.nickname}}" bindtap="showCommentInput">回复</text>
                </view>
              </view>
            </view>
            
            <!-- 二级评论（回复） -->
            <view class="comment-replies" wx:if="{{comment.replies && comment.replies.length > 0}}">
              <view class="reply-item" wx:for="{{comment.replies}}" wx:key="id" wx:for-item="reply" bindlongpress="onReplyLongPress" data-post-id="{{item.id}}" data-comment-id="{{reply.id}}" data-user-id="{{reply.userId}}">
                <image class="reply-avatar" src="{{reply.avatarUrl || '/static/default-avatar.png'}}" mode="aspectFill"></image>
                <view class="reply-content">
                  <view class="reply-header">
                    <text class="reply-name">{{reply.nickname}}</text>
                    <text class="reply-hint" wx:if="{{reply.replyToNickname}}">回复 {{reply.replyToNickname}}</text>
                  </view>
                  <text class="reply-text">{{reply.content}}</text>
                  <view class="reply-actions">
                    <text class="reply-time">{{reply.created_at}}</text>
                    <text class="reply-reply" data-id="{{item.id}}" data-parent-id="{{comment.id}}" data-reply-to-user-id="{{reply.userId}}" data-reply-to-nickname="{{reply.nickname}}" bindtap="showCommentInput">回复</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
        
        <!-- 添加评论按钮 -->
        <view class="add-comment-btn" bindtap="showCommentInput" data-id="{{item.id}}">
          <text>写评论...</text>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
      <text>没有更多了</text>
    </view>
    <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">还没有形体照记录，快去记录第一条吧~</text>
    </view>
  </view>
</view>

