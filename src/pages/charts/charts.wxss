/* pages/charts/charts.wxss */
.charts-page {
  padding: 24rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 0 16rpx;
}

.header .title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
}

/* 图表卡片 */
.chart-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  border-left: 8rpx solid #009688;
  padding-left: 16rpx;
}

.chart-container {
  width: 100%;
  height: 500rpx;
  position: relative;
}

.chart-canvas {
  width: 100%;
  height: 500rpx;
}

/* 趋势图提示样式 */
.chart-tips {
  margin: 20rpx 32rpx 40rpx;
  background-color: #f8f9fa;
  display: flex;
  align-items: flex-start;
}

.tips-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  color: #3498db;
}

.tips-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tips-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.tips-text {
  font-size: 28rpx;
  color: #7f8c8d;
  line-height: 1.5;
}

/* 空数据状态 */
.empty-data {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #95a5a6;
  font-size: 28rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
}