/* pages/measure/measure.wxss */
.container {
  min-height: 100vh;
  background: #F7FAFC;
  padding: 24rpx;
  box-sizing: border-box;
}

/* Calendar Section (Mint Theme) */
.calendar-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.week-calendar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.calendar-arrow {
  padding: 10rpx;
  color: #CBD5E0;
}

.week-days {
  flex: 1;
  display: flex;
  justify-content: space-around;
  padding: 0 10rpx;
}

.day-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 100rpx;
  border-radius: 16rpx;
}

.day-item.today {
  color: #98D8C8; /* Mint Green Text */
}

.day-item.active {
  background: #98D8C8; /* Mint Green Background */
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(152, 216, 200, 0.4);
}

.week-day-text {
  font-size: 22rpx;
  margin-bottom: 8rpx;
  opacity: 0.8;
}

.day-text {
  font-size: 32rpx;
  font-weight: 600;
}

/* Stats Grid */
.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stat-card {
  width: 31%;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.stat-label {
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 12rpx;
}

.stat-value-box {
  display: flex;
  align-items: baseline;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #2D3748;
  margin-right: 4rpx;
  font-family: 'DIN Alternate', sans-serif;
}

.stat-unit {
  font-size: 22rpx;
  color: #A0AEC0;
}

/* WHR Card */
.whr-card {
  background: linear-gradient(135deg, #E0F2F1 0%, #B2DFDB 100%);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #00695C;
}

.whr-info {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.whr-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.whr-value {
  font-size: 36rpx;
  font-weight: bold;
}

.whr-desc {
  font-size: 24rpx;
  opacity: 0.8;
}

/* Instruction List */
.instruction-list {
  margin-top: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3748;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
}

.instruction-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  transition: transform 0.1s;
}

.instruction-card:active {
  transform: scale(0.98);
}

.card-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.card-icon {
  font-size: 40rpx;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2D3748;
  display: block;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #A0AEC0;
  line-height: 1.4;
}

.card-action {
  display: flex;
  align-items: center;
  color: #98D8C8;
}

.action-text {
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 4rpx;
}

/* Input Popup */
.measure-input-popup {
  padding: 40rpx 32rpx;
  background: white;
}

.popup-header {
  text-align: center;
  margin-bottom: 40rpx;
  display: block; /* Override flex */
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2d3748;
  display: block;
  margin-bottom: 12rpx;
}

.popup-date {
  font-size: 28rpx;
  color: #718096;
  display: block;
}

.input-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  padding: 32rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  border-bottom: none; /* Remove old border */
}

.measure-input {
  font-size: 36rpx;
  color: #2d3748;
  text-align: center;
  width: 300rpx;
  height: 80rpx; /* Set fixed height */
  min-height: 80rpx;
  font-family: inherit;
  caret-color: #98D8C8; /* Mint color cursor */
}

.input-unit {
  font-size: 36rpx;
  color: #718096;
  margin-left: 16rpx;
}

.popup-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0;
}

.action-btn {
  width: 337rpx !important;
  border-radius: 16rpx !important;
  height: 88rpx !important;
  font-size: 32rpx !important;
  padding: 0 32rpx !important;
}

.delete-btn {
  background: #fee !important;
  color: #e53e3e !important;
  border: none !important;
}

.cancel-btn {
  background: #f5f7fa !important;
  color: #718096 !important;
  border: none !important;
}

.save-btn {
  background: linear-gradient(135deg, #98D8C8 0%, #38ef7d 100%) !important; /* Mint Gradient */
  border: none !important;
  color: white !important;
  flex: 1 !important;
}
