/* pages/profile/profile.wxss */
.profile-page {
  background: #F7FAFC;
  padding: 24rpx 24rpx 140rpx; /* 增加底部间距，确保内容完整展示 */
}

/* 用户信息卡片 */
/* 用户信息卡片 */
/* 用户信息卡片 */
.user-card {
  background: var(--gradient-tomato);
  border-radius: 32rpx;
  padding: 0;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(233, 80, 63, 0.3); /* Stronger colored shadow */
  overflow: hidden;
  position: relative;
  color: white;
}

/* 顶部背景装饰 - 调整为白色半透明，增加层次感 */
.user-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* 头部：头像和身份 */
.card-header {
  padding: 32rpx 32rpx 12rpx; /* Reduced vertical padding */
  display: flex;
  align-items: center;
  gap: 24rpx;
  position: relative;
}

.avatar {
  width: 100rpx; /* Slightly smaller avatar */
  height: 100rpx;
  border-radius: 50rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.user-identity {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.identity-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: white;
}

.nickname-input {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  width: 300rpx;
}

.nickname-input::placeholder {
  color: rgba(255, 255, 255, 0.7);
}

.vip-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.vip-icon {
  font-size: 18rpx;
}

.vip-text {
  font-size: 18rpx;
  font-weight: bold;
  color: white;
}

.identity-bottom {
  display: flex;
  align-items: center;
}

.expire-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.guest-tip {
  font-size: 26rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #F1E0AD 0%, #D4AF37 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 1rpx;
}

.arrow {
  font-size: 28rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
  margin-top: -2rpx;
}

/* 身体数据网格 - 紧凑型 */
.stats-grid {
  margin-top: 8rpx;
  padding: 12rpx 32rpx 32rpx; /* significantly reduced padding */
  display: flex;
  justify-content: space-around; /* Space around for better balance */
  align-items: flex-end; /* Align bottom to keep labels aligned */
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

.stat-value {
  font-size: 32rpx; /* Smaller font */
  font-weight: 700;
  color: white;
  line-height: 1.2;
}

.stat-unit {
  font-size: 20rpx;
  font-weight: normal;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 2rpx;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.vertical-divider {
  width: 1rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.3);
  margin-bottom: 6rpx;
}

/* 我的目标 */
.goals-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3748;
}

.section-subtitle {
  font-size: 24rpx;
  color: #A0AEC0;
}

.goals-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.goal-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s;
}

.goal-card:active {
  transform: scale(0.95);
}

.goal-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.goal-title {
  font-size: 26rpx;
  color: #4A5568;
  margin-bottom: 16rpx;
}

.goal-value-box {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.goal-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #2D3748;
}

.goal-unit {
  font-size: 24rpx;
  color: #718096;
}

/* 功能菜单 */
.menu-section {
  margin-bottom: 24rpx;
  padding-bottom: 40rpx; /* 与底部留出距离，确保内容完整展示 */
}

.menu-list {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #E2E8F0;
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F7FAFC;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-title {
  font-size: 28rpx;
  color: #2D3748;
}

.menu-arrow {
  font-size: 48rpx;
  color: #CBD5E0;
  font-weight: 300;
}


/* 对话框 */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  overflow: hidden;
}

.dialog-content {
  width: 90%;
  max-width: 600rpx;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  margin: 0 auto;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #E2E8F0;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2D3748;
}

.dialog-close {
  font-size: 40rpx;
  color: #A0AEC0;
  padding: 0 8rpx;
}

.dialog-body {
  padding: 32rpx;
  overflow-x: hidden;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #4A5568;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  min-height: 80rpx;
  padding: 24rpx 20rpx;
  background: #F7FAFC;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.dialog-footer {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 32rpx;
}

.dialog-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.dialog-btn.cancel {
  background: #EDF2F7;
  color: #4A5568;
}

.dialog-btn.confirm {
  background: var(--gradient-tomato);
  color: white;
}
