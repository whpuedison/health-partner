/* Pages: Unified Health Membership Redesign */

.member-page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  position: relative;
}



/* 主卡片容器 */
.main-card {
  background: linear-gradient(135deg, #222 0%, #333 100%);
  border-radius: 32rpx;
  padding: 64rpx 40rpx;
  max-width: 680rpx;
  width: 100%;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

/* 头部区域 */
.header-section {
  padding: 0;
  margin-bottom: 48rpx;
  text-align: center;
}

/* 移除用户简介样式 */

/* 会员卡片 - 延续 user-card 风格但更精致 */
.vip-card-box {
  margin-top: 20rpx;
}

.vip-card {
  background: transparent;
  border-radius: 0;
  padding: 0;
  margin-bottom: 40rpx;
  position: relative;
  overflow: visible;
  box-shadow: none;
  color: #F1E0AD;
  border: none;
}

.card-bg-mesh {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 140%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  pointer-events: none;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.card-body {
  display: flex;
  flex-direction: column;
  align-items: center; 
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.brand-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.h-line {
  flex: 1;
  height: 1rpx;
  background: currentColor;
  opacity: 0.2;
}

.brand {
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

.card-title {
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-align: center;
}

.card-status-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.card-status-label .tag {
  font-size: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  letter-spacing: 2rpx;
  font-weight: bold;
}

.card-status-label .date {
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 25rpx;
}

.card-stats {
  display: flex;
  width: 100%;
  justify-content: space-around;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.vip-card:not(.is-active) .card-stats {
  border-color: rgba(0, 0, 0, 0.1);
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat .num {
  font-size: 36rpx;
  font-weight: bold;
  font-family: 'DIN Condensed', sans-serif;
}

.stat .txt {
  font-size: 22rpx;
  opacity: 0.6;
}

.sep {
  width: 1rpx;
  height: 40rpx;
  background: currentColor;
  opacity: 0.1;
  align-self: center;
}

.card-footer {
  text-align: center;
  font-size: 22rpx;
  opacity: 0.6;
}

/* 内容区域 */
.content-container {
  padding: 0;
  margin: 0;
  position: relative;
  z-index: 2;
}

.section-card {
  background: transparent;
  border-radius: 0;
  padding: 0;
  margin-bottom: 48rpx;
  box-shadow: none;
  border: none;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: rgba(241, 224, 173, 0.8);
  margin-bottom: 24rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

/* 会员权益列表 */
.benefits-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.icon-box {
  width: 80rpx;
  height: 80rpx;
  background: rgba(241, 224, 173, 0.1);
  border: 1px solid rgba(241, 224, 173, 0.2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.text-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #F1E0AD;
}

.item-desc {
  font-size: 24rpx;
  color: rgba(241, 224, 173, 0.7);
}

.check-box {
  color: var(--tomato-red);
  font-weight: bold;
}


/* 会员方案列表 */

.plan-list {
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
}

.plan-item {
  flex: 1;
  border: 2rpx solid rgba(241, 224, 173, 0.25);
  background: linear-gradient(135deg, #2a2a2a 0%, #1f1f1f 100%);
  border-radius: 28rpx;
  padding: 48rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  box-sizing: border-box;
  min-width: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.plan-item.selected {
  border-color: #F1E0AD;
  background: linear-gradient(135deg, rgba(241, 224, 173, 0.15) 0%, rgba(212, 175, 55, 0.1) 100%);
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(241, 224, 173, 0.25), 0 0 40rpx rgba(241, 224, 173, 0.1);
}

.plan-tag {
  position: absolute;
  top: -16rpx;
  left: 20rpx;
  background: linear-gradient(135deg, #F1E0AD 0%, #D4AF37 100%);
  color: #1a1a1a;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.plan-name {
  font-size: 26rpx;
  color: rgba(241, 224, 173, 0.9);
  margin-bottom: 16rpx;
}

.plan-price {
  display: flex;
  align-items: baseline;
  color: #F1E0AD;
  margin-bottom: 8rpx;
}

.plan-price .symbol {
  font-size: 24rpx;
  font-weight: bold;
}

.plan-price .amount {
  font-size: 42rpx; /* 适配更窄的卡片 */
  font-weight: bold;
  font-family: 'DIN Condensed', -apple-system, system-ui, sans-serif;
}

.plan-daily {
  font-size: 20rpx;
  color: rgba(241, 224, 173, 0.6);
}






.pay-button {
  width: 100%;
  background: linear-gradient(135deg, #F1E0AD 0%, #D4AF37 100%);
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: bold;
  padding: 0;
  height: 108rpx;
  line-height: 108rpx;
  border-radius: 54rpx;
  margin-top: 48rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(241, 224, 173, 0.4), 0 0 60rpx rgba(241, 224, 173, 0.2);
  animation: payBreathe 2s infinite ease-in-out;
  position: relative;
  overflow: hidden;
}

/* 按钮内部光泽效果 */
.pay-button::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.3) 50%, transparent 70%);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
  100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
}

@keyframes payBreathe {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 12rpx 32rpx rgba(241, 224, 173, 0.4), 0 0 60rpx rgba(241, 224, 173, 0.2);
  }
  50% {
    transform: scale(1.03);
    box-shadow: 0 16rpx 40rpx rgba(241, 224, 173, 0.5), 0 0 80rpx rgba(241, 224, 173, 0.3);
  }
}

.pay-button:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* iOS Notice */
.ios-notice {
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 20rpx;
  display: flex;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--gray-medium);
  line-height: 1.5;
}

.ios-notice .icon {
  font-size: 32rpx;
}

.safe-area-inset {
  height: env(safe-area-inset-bottom);
}
