/* pages/weight/weight.wxss */
.weight-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 统计卡片 */
.stats-card {
  background: var(--gradient-tomato);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(233, 80, 63, 0.3);
}

.stats-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 24rpx;
  font-weight: 500;
}

.stats-content {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  color: white;
  font-weight: 600;
}

/* 日历卡片 */
.calendar-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 月份切换 */
.month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-nav {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f7fa;
  transition: all 0.3s;
}

.month-nav:active {
  background: #e8ecf0;
  transform: scale(0.95);
}

.nav-icon {
  font-size: 24rpx;
  color: var(--tomato-red);
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
}

/* 星期标题 */
.week-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 16rpx;
}

.week-day {
  text-align: center;
  font-size: 24rpx;
  color: #718096;
  font-weight: 500;
}

/* 日历网格 */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  /* gap: 8rpx; 如果需要间距可以用gap，但这里原有设计是紧凑的 */
}

.calendar-day {
  width: 100%;
  box-sizing: border-box;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  transition: all 0.3s;
  position: relative;
}

.calendar-day.empty {
  pointer-events: none;
}

.calendar-day.today {
  background: var(--pale-orange); /* Theme variable */
}

.calendar-day.today .day-number {
  color: var(--tomato-red);
  font-weight: 600;
}

.calendar-day:not(.empty):active {
  background: #f5f7fa;
  transform: scale(0.95);
}

.day-number {
  font-size: 28rpx;
  color: #2d3748;
  margin-bottom: 4rpx;
}

.day-weight {
  font-size: 20rpx;
  color: var(--tomato-deep);
  font-weight: 600;
  background: rgba(233, 80, 63, 0.1);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
}

/* 体重输入弹窗 */
.weight-input-popup {
  padding: 40rpx 32rpx;
  background: white;
}

.popup-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2d3748;
  display: block;
  margin-bottom: 12rpx;
}

.popup-date {
  font-size: 28rpx;
  color: #718096;
}

/* 输入容器 */
.input-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  padding: 32rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.weight-input {
  font-size: 36rpx;
  color: #2d3748;
  text-align: center;
  width: 300rpx;
}

.input-unit {
  font-size: 36rpx;
  color: #718096;
  margin-left: 16rpx;
}

/* 弹窗按钮 */
.popup-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.delete-btn,
.cancel-btn,
.save-btn {
  width: 337rpx !important;
  border-radius: 16rpx !important;
  height: 88rpx !important;
  font-size: 32rpx !important;
  padding: 0 32rpx !important;
}

.delete-btn {
  background: #fee !important;
  color: #e53e3e !important;
  border: none !important;
}

.cancel-btn {
  background: #f5f7fa !important;
  color: #718096 !important;
  border: none !important;
}

.save-btn {
  background: var(--gradient-tomato) !important;
  border: none !important;
  color: white !important;
  flex: 1 !important;
}
