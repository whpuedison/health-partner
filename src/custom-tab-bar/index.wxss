/* custom-tab-bar/index.wxss */
@import "../app.wxss";

.tab-bar {
  /* Ensure variables are available in this isolated component scope */
  --tomato-red: #E9503F;
  --tomato-deep: #D92F20;
  --gradient-tomato: linear-gradient(135deg, #E9503F 0%, #D92F20 100%);
  --gradient-orange: linear-gradient(135deg, #EF8F41 0%, #E9503F 100%);
  
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: white;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 9999;
  border-top: 1rpx solid #E2E8F0;
  transition: all 0.3s;
}

/* 子菜单弹出时，TabBar背景透明 */
.tab-bar.transparent {
  background: transparent;
  box-shadow: none;
  border-top: none;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: all 0.3s;
  position: relative;
}

.tab-icon {
  font-size: 44rpx;
  transition: transform 0.3s;
}

.tab-item.active .tab-icon {
  transform: scale(1.1);
}

.tab-text {
  font-size: 20rpx;
  color: #718096;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: var(--tomato-red);
  font-weight: 600;
}

/* 子菜单弹出时隐藏主菜单项 */
.tab-item.hidden {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

/* 中间添加按钮特殊样式 */
.tab-item.add-button {
  position: relative;
  z-index: 10001; /* 确保在子菜单之上 */
}

.tab-item.add-button .tab-icon {
  width: 100rpx;
  height: 100rpx;
  line-height: 90rpx; /* Slightly adjust for visual centering */
  text-align: center;
  font-size: 70rpx; /* Larger font for the text '+' */
  background: var(--gradient-tomato);
  border-radius: 50%;
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(233, 80, 63, 0.4);
  transform: translateY(-20rpx);
  transition: all 0.3s;
  position: relative;
  z-index: 10001; /* 确保图标在最上层 */
}

/* +按钮旋转45度变成× */
.tab-item.add-button .tab-icon.rotate {
  transform: translateY(-20rpx) rotate(45deg);
}

.tab-item.add-button:active .tab-icon {
  transform: translateY(-20rpx) scale(0.95);
}

.tab-item.add-button:active .tab-icon.rotate {
  transform: translateY(-20rpx) rotate(45deg) scale(0.95);
}

/* 遮罩层 - 覆盖整个屏幕 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9998;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

/* 子菜单容器（扇形布局 - 单圈） */
.sub-menu-container {
  position: fixed;
  left: 50%;
  bottom: 120rpx;  /* 提高位置，避免与TabBar遮挡 */
  width: 500rpx;
  height: 300rpx;
  transform: translateX(-50%);
  z-index: 10000;
  pointer-events: none; /* 容器本身不响应点击，让点击穿透 */
  opacity: 0;
  transition: opacity 0.3s;
}

.sub-menu-container.show {
  opacity: 1;
  /* 不设置pointer-events: auto，保持none让点击穿透 */
}

/* 子菜单项（单圈扇形排列） */
.sub-menu-item {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 100rpx;
  height: 100rpx;
  margin-left: -50rpx;
  transform-origin: center bottom;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  opacity: 0;
  transform: translateY(0) scale(0);
  pointer-events: auto; /* 子菜单项可点击 */
}

.sub-menu-container.show .sub-menu-item {
  opacity: 1;
}

/* 精确计算：5个菜单项在同一圆弧上 */
/* 半径：200rpx，扇形范围：180度（-90度到+90度） */
/* 每个菜单项间隔：45度 */

/* 菜单项0 - 左边（-90度） */
.sub-menu-container.show .sub-menu-item.item-0 {
  /* X = 200 * sin(-90°) = -200 */
  /* Y = -200 * cos(-90°) = 0 */
  transform: translate(-200rpx, 0) scale(1);
}

/* 菜单项1 - 左中（-45度） */
.sub-menu-container.show .sub-menu-item.item-1 {
  /* X = 200 * sin(-45°) = -141.42 */
  /* Y = -200 * cos(-45°) = -141.42 */
  transform: translate(-141rpx, -141rpx) scale(1);
}

/* 菜单项2 - 正上（0度） */
.sub-menu-container.show .sub-menu-item.item-2 {
  /* X = 200 * sin(0°) = 0 */
  /* Y = -200 * cos(0°) = -200 */
  transform: translate(0, -200rpx) scale(1);
}

/* 菜单项3 - 右中（45度） */
.sub-menu-container.show .sub-menu-item.item-3 {
  /* X = 200 * sin(45°) = 141.42 */
  /* Y = -200 * cos(45°) = -141.42 */
  transform: translate(141rpx, -141rpx) scale(1);
}

/* 菜单项4 - 右边（90度） */
.sub-menu-container.show .sub-menu-item.item-4 {
  /* X = 200 * sin(90°) = 200 */
  /* Y = -200 * cos(90°) = 0 */
  transform: translate(200rpx, 0) scale(1);
}

/* 菜单项内容 */
.sub-menu-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background-color: rgba(255, 255, 255, 0.9);
  /* background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%); */
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all 0.2s;
}

.sub-menu-item.active .sub-menu-content {
  background: var(--gradient-orange);
  transform: scale(1.1);
  box-shadow: 0 12rpx 32rpx rgba(233, 80, 63, 0.4);
}

.sub-menu-icon {
  font-size: 40rpx;
  transition: transform 0.2s;
}

.sub-menu-item.active .sub-menu-icon {
  transform: scale(1.1);
}

.sub-menu-text {
  font-size: 18rpx;
  color: #2D3748;
  font-weight: 500;
  transition: all 0.2s;
  white-space: nowrap;
}

.sub-menu-item.active .sub-menu-text {
  color: white;
}
