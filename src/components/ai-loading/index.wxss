/* CSS 变量参考 app.wxss */
.ai-loading-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  pointer-events: none; /* 默认不阻挡点击，显示时阻挡 */
}

.ai-loading-container.show {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4); /* 稍微深一点的半透明遮罩，聚焦视线但保留背景感知 */
  /* 移除模糊，避免"页面跳转"感 */
}

.content-box {
  position: relative;
  width: 72%;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  animation: scaleIn 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

@keyframes scaleIn {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* 动画区域 */
.animation-area {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-wrapper {
  font-size: 80rpx;
  z-index: 2;
  animation: bounce 2s infinite ease-in-out;
}

.pulse-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(233, 80, 63, 0.3); /* Tomato Red alpha */
  animation: pulse 2s infinite;
}

.pulse-ring.delay-1 {
  animation-delay: 0.6s;
}

@keyframes pulse {
  0% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.8; }
  100% { transform: translate(-50%, -50%) scale(1.6); opacity: 0; }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* 文本 */
.status-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
}
.dots {
    width: 24rpx;
    text-align: left;
}

/* 进度条 */
.progress-bar-bg {
  width: 100%;
  height: 12rpx; /* 稍微加高 */
  background: #f0f0f0;
  border-radius: 6rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(135deg, #EF8F41 0%, #E9503F 100%); /* Tomato Gradient */
  border-radius: 6rpx;
  transition: width 0.2s linear;
}

/* 知识卡片 */
.tip-card {
  width: 100%;
  background: #FFF4ED; /* Pale Orange bg */
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.tip-title {
  font-size: 24rpx;
  color: #E9503F; /* Tomato Red */
  font-weight: 600;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  min-height: 80rpx; 
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.cancel-btn {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #999;
  padding: 16rpx 40rpx;
  border: 1rpx solid #eee;
  border-radius: 40rpx;
  background: #f8f8f8;
  transition: all 0.2s;
}

.cancel-btn:active {
  background: #f0f0f0;
  opacity: 0.8;
}
